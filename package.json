{
  "name": "wattnet.eu",
  "description": "An open-source service for tracking the environmental footprint of electricity across Europe",
  "author": "Jaime Iglesias Blanco",
  "homepage": "https://wattnet.eu",
  "repository": {
    "type": "git",
    "url": "https://github.com/wattnet/wattnet.eu"
  },
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "check": "astro check",
    "format": "prettier --write \"src/**/*.{astro,ts,js,jsx,tsx,css}\" astro.config.mjs package.json tsconfig.json",
    "format:check": "prettier --check \"src/**/*.{astro,ts,js,jsx,tsx,css}\" astro.config.mjs package.json tsconfig.json",
    "preview": "astro build && astro preview",
    "astro": "astro",
    "test": "node --test src/lib/*.test.js"
  },
  "overrides": {
    "esbuild": "0.28.1",
    "js-yaml": "^4.1.2",
    "postcss-selector-parser": "^6.1.5"
  },
  "dependencies": {
    "@astrojs/alpinejs": "^1.0.0",
    "@astrojs/mdx": "^8.1.6",
    "@astrojs/preact": "^6.1.6",
    "@astrojs/sitemap": "^3.7.6",
    "@iconify-json/simple-icons": "^1.2.103",
    "@plausible-analytics/tracker": "^0.4.7",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.5",
    "alpinejs": "^3.17.5",
    "astro": "^7.4.13",
    "astro-icon": "^1.1.5",
    "lottie-web": "^5.13.0",
    "lucide-preact": "^1.78.0",
    "preact": "^11.2.0",
    "tailwindcss": "^4.3.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "prettier": "^3.10.1",
    "prettier-plugin-astro": "^1.1.2",
    "typescript": "^7.0.2"
  }
}
