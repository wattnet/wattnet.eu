---
---

<section id="datasets" class="section bg-white/70 dark:bg-gray-800/50">
  <div class="container-custom slide-up">
    <div class="text-center max-w-6xl mx-auto mb-16">
      <span class="eyebrow">Curated Datasets</span>
      <h2 class="mb-6 bg-gradient-to-r from-gray-900 via-primary-700 to-primary-500 dark:from-white dark:via-primary-200 dark:to-primary-400 bg-clip-text text-transparent">
        Ready-to-use, High-Quality Data Collections
      </h2>
      <p class="text-gray-600 dark:text-gray-300">
        Explore curated datasets covering energy generation, cross-border exchanges, and
        environmental footprints for research and analysis.
      </p>
    </div>

    <div class="grid md:grid-cols-2 lg:grid-cols-3 divide-y divide-secondary-200/60 dark:divide-secondary-800/60 border-y border-secondary-200/60 dark:border-secondary-800/60 bg-gray-100 dark:bg-gray-900/40">
      <!-- Electricity Generation -->
      <div class="relative p-6 sm:p-8">
        <span class="absolute top-6 right-6 sm:top-8 sm:right-8 text-xs font-mono font-medium text-gray-300 dark:text-gray-600 select-none">
          01
        </span>
        <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-yellow-100 to-yellow-200 dark:from-yellow-900/50 dark:to-yellow-800/30 flex items-center justify-center mb-5">
          <svg
            class="w-6 h-6 text-yellow-600 dark:text-yellow-400"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M13 10V3L4 14h7v7l9-11h-7z"
            />
          </svg>
        </div>
        <h3 class="text-xl font-semibold mb-3 text-gray-900 dark:text-white">
          Electricity Generation
        </h3>
        <p class="text-gray-600 dark:text-gray-300">
          Detailed 15-minute resolution insights into electricity production by generation type
          across Europe.
        </p>
      </div>

      <!-- Cross-Border Exchanges -->
      <div class="relative p-6 sm:p-8">
        <span class="absolute top-6 right-6 sm:top-8 sm:right-8 text-xs font-mono font-medium text-gray-300 dark:text-gray-600 select-none">
          02
        </span>
        <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-blue-100 to-blue-200 dark:from-blue-900/50 dark:to-blue-800/30 flex items-center justify-center mb-5">
          <svg
            class="w-6 h-6 text-blue-600 dark:text-blue-400"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M5 7h14m0 0l-3-3m3 3l-3 3"
            />
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M19 17H5m0 0l3-3m-3 3l3 3"
            />
          </svg>
        </div>
        <h3 class="text-xl font-semibold mb-3 text-gray-900 dark:text-white">
          Cross-Border Exchanges
        </h3>
        <p class="text-gray-600 dark:text-gray-300">
          Track imports and exports of electricity between European countries and regions in real
          time.
        </p>
      </div>

      <!-- Carbon & Water Footprints -->
      <div class="relative p-6 sm:p-8">
        <span class="absolute top-6 right-6 sm:top-8 sm:right-8 text-xs font-mono font-medium text-gray-300 dark:text-gray-600 select-none">
          03
        </span>
        <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-green-100 to-green-200 dark:from-green-900/50 dark:to-green-800/30 flex items-center justify-center mb-5">
          <svg
            class="w-6 h-6 text-green-600 dark:text-green-400"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 21V12" />
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M12 12C7 12 4 8 4 5c0 0 4 1 8 5z"
            />
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M12 12c5 0 7-4 7-6 0 0-3 1-7 6z"
            />
          </svg>
        </div>
        <h3 class="text-xl font-semibold mb-3 text-gray-900 dark:text-white">
          Carbon & Water Footprints
        </h3>
        <p class="text-gray-600 dark:text-gray-300">
          Monitor carbon emissions and water consumption for electricity, helping track
          environmental impact.
        </p>
      </div>
    </div>

    <div class="flex justify-end mt-8">
      <a href="/resources#datasets" class="btn-secondary">
        Explore All Datasets
      </a>
    </div>
  </div>
</section>
