---
---

<section
  id="python-client"
  class="section bg-white/70 dark:bg-gray-800/50 relative overflow-hidden"
>
  <div class="container-custom slide-up">
    <div class="grid md:[grid-template-columns:60fr_40fr] gap-12 lg:gap-16 items-center">
      <!-- IDE mockup -->
      <div
        x-data="{ tab: 'quickstart', file: 'quickstart.py', auto: !window.matchMedia('(prefers-reduced-motion: reduce)').matches, paused: false, order: [['quickstart', 'quickstart.py'], ['score', 'by_location.py'], ['async', 'async_example.py']], next() { const i = this.order.findIndex(t => t[0] === this.tab); [this.tab, this.file] = this.order[(i + 1) % this.order.length] } }"
        x-init="setInterval(() => { if (auto && !paused && !document.hidden) next() }, 6000)"
        @mouseenter="paused = true"
        @mouseleave="paused = false"
        @focusin="paused = true"
        @focusout="paused = false"
        class="rounded-xl overflow-hidden shadow-2xl border border-gray-200/60 dark:border-white/10 flex flex-col order-2 md:order-1 bg-gray-100/80 dark:bg-gray-800/40 backdrop-blur-md font-mono text-[13px]"
      >
        <!-- Title bar -->
        <div class="flex items-center gap-3 px-4 py-2.5 bg-white/70 dark:bg-gray-900/60 backdrop-blur-md border-b border-gray-200/60 dark:border-white/10 shrink-0">
          <div class="flex gap-1.5 shrink-0">
            <span class="w-3 h-3 rounded-full bg-red-400"></span>
            <span class="w-3 h-3 rounded-full bg-yellow-400"></span>
            <span class="w-3 h-3 rounded-full bg-green-400"></span>
          </div>
          <span class="flex-1 text-center text-xs text-gray-600 dark:text-gray-400 truncate">
            <span x-text="file">quickstart.py</span> - wattnet-client-demo
          </span>
          <span class="w-12 shrink-0"></span>
        </div>
        <div class="flex">
          <!-- Activity bar -->
          <div
            class="hidden sm:flex flex-col items-center gap-4 py-3 px-2.5 bg-white/40 dark:bg-gray-900/40 text-gray-500 dark:text-gray-400 shrink-0"
            aria-hidden="true"
          >
            <svg
              class="w-5 h-5 text-gray-800 dark:text-white"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              viewBox="0 0 24 24"
            >
              <path stroke-linecap="round" stroke-linejoin="round" d="M7 3h7l5 5v13H7zM14 3v5h5" />
            </svg>
            <svg
              class="w-5 h-5"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              viewBox="0 0 24 24"
            >
              <circle cx="11" cy="11" r="6" />
              <path stroke-linecap="round" d="M20 20l-4.5-4.5" />
            </svg>
            <svg
              class="w-5 h-5"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              viewBox="0 0 24 24"
            >
              <circle cx="6" cy="6" r="2" />
              <circle cx="6" cy="18" r="2" />
              <circle cx="18" cy="8" r="2" />
              <path d="M6 8v8M18 10c0 4-8 2-12 6" />
            </svg>
            <svg
              class="w-5 h-5"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              stroke-linejoin="round"
              viewBox="0 0 24 24"
            >
              <path d="M10 19.655A6 6 0 0 1 6 14v-3a4 4 0 0 1 4-4h4a4 4 0 0 1 4 3.97" />
              <path d="M14 15.003a1 1 0 0 1 1.517-.859l4.997 2.997a1 1 0 0 1 0 1.718l-4.997 2.997a1 1 0 0 1-1.517-.86z" />
              <path d="M14.12 3.88 16 2" />
              <path d="M21 5a4 4 0 0 1-3.55 3.97" />
              <path d="M3 21a4 4 0 0 1 3.81-4" />
              <path d="M3 5a4 4 0 0 0 3.55 3.97" />
              <path d="M6 13H2" />
              <path d="m8 2 1.88 1.88" />
              <path d="M9 7.13V6a3 3 0 1 1 6 0v1.13" />
            </svg>
            <svg
              class="w-5 h-5"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              stroke-linejoin="round"
              viewBox="0 0 24 24"
            >
              <rect x="3" y="12" width="8" height="8" rx="1" />
              <rect x="13" y="12" width="8" height="8" rx="1" />
              <rect x="3" y="4" width="8" height="6" rx="1" />
              <path d="M17 3v6M14 6h6" />
            </svg>
            <svg
              class="w-5 h-5"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              stroke-linejoin="round"
              viewBox="0 0 24 24"
            >
              <rect x="6" y="3" width="12" height="18" rx="2" />
              <path d="M9 7h6M9 11h6M9 15h3" />
            </svg>
            <div class="mt-auto flex flex-col items-center gap-4">
              <svg
                class="w-5 h-5"
                fill="none"
                stroke="currentColor"
                stroke-width="1.6"
                stroke-linecap="round"
                stroke-linejoin="round"
                viewBox="0 0 24 24"
              >
                <circle cx="12" cy="8" r="4" />
                <path d="M4 21c0-4.4 3.6-8 8-8s8 3.6 8 8" />
              </svg>
              <svg
                class="w-5 h-5"
                fill="none"
                stroke="currentColor"
                stroke-width="1.6"
                stroke-linecap="round"
                stroke-linejoin="round"
                viewBox="0 0 24 24"
              >
                <path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z" />
                <circle cx="12" cy="12" r="3" />
              </svg>
            </div>
          </div>
          <div class="flex-1 min-w-0 flex flex-col">
            <!-- Tabs -->
            <div
              class="flex bg-white/40 dark:bg-gray-900/40 text-xs shrink-0 overflow-x-auto"
              role="tablist"
              aria-label="Python client examples"
            >
              <button
                type="button"
                role="tab"
                @click="tab = 'quickstart'; file = 'quickstart.py'; auto = false"
                :aria-selected="tab === 'quickstart'"
                class="flex items-center gap-2 px-4 py-2 whitespace-nowrap border-t-2 transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-primary-500"
                :class="tab === 'quickstart' ? 'bg-gray-100/60 dark:bg-white/5 text-gray-800 dark:text-gray-200 border-primary-500' : 'text-gray-500 hover:text-gray-800 dark:hover:text-gray-200 border-transparent'"
              >
                <span class="text-yellow-600 dark:text-yellow-400">py</span> quickstart.py
              </button>
              <button
                type="button"
                role="tab"
                @click="tab = 'score'; file = 'by_location.py'; auto = false"
                :aria-selected="tab === 'score'"
                class="flex items-center gap-2 px-4 py-2 whitespace-nowrap border-t-2 transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-primary-500"
                :class="tab === 'score' ? 'bg-gray-100/60 dark:bg-white/5 text-gray-800 dark:text-gray-200 border-primary-500' : 'text-gray-500 hover:text-gray-800 dark:hover:text-gray-200 border-transparent'"
              >
                <span class="text-yellow-600 dark:text-yellow-400">py</span> by_location.py
              </button>
              <button
                type="button"
                role="tab"
                @click="tab = 'async'; file = 'async_example.py'; auto = false"
                :aria-selected="tab === 'async'"
                class="flex items-center gap-2 px-4 py-2 whitespace-nowrap border-t-2 transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-primary-500"
                :class="tab === 'async' ? 'bg-gray-100/60 dark:bg-white/5 text-gray-800 dark:text-gray-200 border-primary-500' : 'text-gray-500 hover:text-gray-800 dark:hover:text-gray-200 border-transparent'"
              >
                <span class="text-yellow-600 dark:text-yellow-400">py</span> async_example.py
              </button>
            </div>
            <div class="grid">
              <div
                class="col-start-1 row-start-1"
                :class="{ 'invisible': tab !== 'quickstart' }"
                :aria-hidden="tab !== 'quickstart'"
                role="tabpanel"
              >
                <!-- Editor -->
                <div class="flex overflow-x-auto py-4 leading-6 h-[344px]">
                  <div
                    class="select-none text-right text-gray-400 dark:text-gray-600 pl-4 pr-4 shrink-0"
                    aria-hidden="true"
                  >
                    1<br />2<br />3<br />4<br />5<br />6<br />7<br />8<br />9<br />
                    10
                    <br />
                    11
                    <br />
                    12
                    <br />
                    13
                  </div>
                  <pre class="text-gray-800 dark:text-[#d4d4d4] pr-4"><span class="text-purple-600 dark:text-[#c586c0]">from</span> wattnet.client <span class="text-purple-600 dark:text-[#c586c0]">import</span> <span class="text-teal-700 dark:text-[#4ec9b0]">WattnetClient</span>

client = <span class="text-teal-700 dark:text-[#4ec9b0]">WattnetClient</span>(
client_id=<span class="text-orange-700 dark:text-[#ce9178]">&quot;&lt;your-client-id&gt;&quot;</span>,
client_secret=<span class="text-orange-700 dark:text-[#ce9178]">&quot;&lt;your-client-secret&gt;&quot;</span>,
)

<span class="text-green-700 dark:text-[#6a9955]"># Every call returns a pandas DataFrame</span>
df = client.<span class="text-yellow-700 dark:text-[#dcdcaa]">get_footprints</span>(zone=<span class="text-orange-700 dark:text-[#ce9178]">&quot;ES&quot;</span>, footprint_type=<span class="text-orange-700 dark:text-[#ce9178]">&quot;carbon&quot;</span>)
<span class="text-green-700 dark:text-[#6a9955]"># Solar generation, same zone</span>
solar = client.<span class="text-yellow-700 dark:text-[#dcdcaa]">get_generation</span>(zone=<span class="text-orange-700 dark:text-[#ce9178]">&quot;ES&quot;</span>, production_type=<span class="text-orange-700 dark:text-[#ce9178]">&quot;solar&quot;</span>)

<span class="text-yellow-700 dark:text-[#dcdcaa]">print</span>(df.<span class="text-yellow-700 dark:text-[#dcdcaa]">tail</span>(<span class="text-green-800 dark:text-[#b5cea8]">3</span>))</pre>
                </div>
                <!-- Terminal panel -->
                <div class="border-t border-gray-200/60 dark:border-white/10 bg-white/40 dark:bg-gray-900/40">
                  <div class="flex gap-5 px-4 pt-2 text-[11px] uppercase tracking-wide text-gray-500 dark:text-gray-500">
                    <span>Problems</span>
                    <span>Output</span>
                    <span class="text-gray-800 dark:text-gray-200 border-b border-primary-500 pb-1">
                      Terminal
                    </span>
                  </div>
                  <div class="px-4 py-3.5 overflow-x-auto">
                    <pre class="text-gray-700 dark:text-[#cccccc] leading-[22px] min-h-[110px]"><span class="text-accent-600 dark:text-accent-400">$</span> python quickstart.py
  zone footprint_type       scope     unit   value           timestamp
  ES   carbon         life-cycle  gCO2/kWh  91.96  2025-09-01 01:00:00+00:00
  ES   carbon         life-cycle  gCO2/kWh  90.41  2025-09-01 01:15:00+00:00
  ES   carbon         life-cycle  gCO2/kWh  88.73  2025-09-01 01:30:00+00:00</pre>
                  </div>
                </div>
              </div>
              <div
                class="col-start-1 row-start-1 invisible"
                :class="{ 'invisible': tab !== 'score' }"
                :aria-hidden="tab !== 'score'"
                role="tabpanel"
              >
                <!-- Editor -->
                <div class="flex overflow-x-auto py-4 leading-6 h-[344px]">
                  <div
                    class="select-none text-right text-gray-400 dark:text-gray-600 pl-4 pr-4 shrink-0"
                    aria-hidden="true"
                  >
                    1<br />2<br />3<br />4<br />5<br />6<br />7<br />8<br />9<br />
                    10
                    <br />
                    11
                    <br />
                    12
                    <br />
                    13
                  </div>
                  <pre class="text-gray-800 dark:text-[#d4d4d4] pr-4"><span class="text-purple-600 dark:text-[#c586c0]">from</span> wattnet.client <span class="text-purple-600 dark:text-[#c586c0]">import</span> <span class="text-teal-700 dark:text-[#4ec9b0]">WattnetClient</span>

client = <span class="text-teal-700 dark:text-[#4ec9b0]">WattnetClient</span>(token=<span class="text-orange-700 dark:text-[#ce9178]">&quot;&lt;your-token&gt;&quot;</span>)

<span class="text-green-700 dark:text-[#6a9955]"># Query by coordinates instead of a zone code</span>
df = client.<span class="text-yellow-700 dark:text-[#dcdcaa]">get_footprints</span>(
lat=<span class="text-green-800 dark:text-[#b5cea8]">43.4717</span>, lon=<span class="text-green-800 dark:text-[#b5cea8]">-3.8024</span>,
footprint_type=<span class="text-orange-700 dark:text-[#ce9178]">&quot;carbon&quot;</span>,
start=<span class="text-orange-700 dark:text-[#ce9178]">&quot;2025-09-01T01:02:03Z&quot;</span>,
end=<span class="text-orange-700 dark:text-[#ce9178]">&quot;2025-09-01T04:05:06Z&quot;</span>,
aggregate=<span class="text-purple-600 dark:text-[#c586c0]">True</span>,
)
<span class="text-yellow-700 dark:text-[#dcdcaa]">print</span>(df)</pre>
                </div>
                <!-- Terminal panel -->
                <div class="border-t border-gray-200/60 dark:border-white/10 bg-white/40 dark:bg-gray-900/40">
                  <div class="flex gap-5 px-4 pt-2 text-[11px] uppercase tracking-wide text-gray-500 dark:text-gray-500">
                    <span>Problems</span>
                    <span>Output</span>
                    <span class="text-gray-800 dark:text-gray-200 border-b border-primary-500 pb-1">
                      Terminal
                    </span>
                  </div>
                  <div class="px-4 py-3.5 overflow-x-auto">
                    <pre class="text-gray-700 dark:text-[#cccccc] leading-[22px] min-h-[110px]"><span class="text-accent-600 dark:text-accent-400">$</span> python by_location.py
footprint_type       scope zone      unit   value  valid
carbon        life-cycle   ES  gCO2/kWh  91.963   True</pre>
                  </div>
                </div>
              </div>
              <div
                class="col-start-1 row-start-1 invisible"
                :class="{ 'invisible': tab !== 'async' }"
                :aria-hidden="tab !== 'async'"
                role="tabpanel"
              >
                <!-- Editor -->
                <div class="flex overflow-x-auto py-4 leading-6 h-[344px]">
                  <div
                    class="select-none text-right text-gray-400 dark:text-gray-600 pl-4 pr-4 shrink-0"
                    aria-hidden="true"
                  >
                    1<br />2<br />3<br />4<br />5<br />6<br />7<br />8<br />9<br />
                    10
                    <br />
                    11
                    <br />
                    12
                    <br />
                    13
                  </div>
                  <pre class="text-gray-800 dark:text-[#d4d4d4] pr-4"><span class="text-purple-600 dark:text-[#c586c0]">import</span> asyncio

<span class="text-purple-600 dark:text-[#c586c0]">from</span> wattnet.client <span class="text-purple-600 dark:text-[#c586c0]">import</span> <span class="text-teal-700 dark:text-[#4ec9b0]">AsyncWattnetRawClient</span>

<span class="text-purple-600 dark:text-[#c586c0]">async def</span> <span class="text-yellow-700 dark:text-[#dcdcaa]">main</span>() -> <span class="text-teal-700 dark:text-[#4ec9b0]">None</span>:
<span class="text-purple-600 dark:text-[#c586c0]">async with</span> <span class="text-teal-700 dark:text-[#4ec9b0]">AsyncWattnetRawClient</span>(token=<span class="text-orange-700 dark:text-[#ce9178]">&quot;&lt;your-token&gt;&quot;</span>) <span class="text-purple-600 dark:text-[#c586c0]">as</span> client:
    carbon, water = <span class="text-purple-600 dark:text-[#c586c0]">await</span> asyncio.<span class="text-yellow-700 dark:text-[#dcdcaa]">gather</span>(
        client.<span class="text-yellow-700 dark:text-[#dcdcaa]">get_footprints</span>(zone=<span class="text-orange-700 dark:text-[#ce9178]">&quot;ES&quot;</span>, footprint_type=<span class="text-orange-700 dark:text-[#ce9178]">&quot;carbon&quot;</span>),
        client.<span class="text-yellow-700 dark:text-[#dcdcaa]">get_footprints</span>(zone=<span class="text-orange-700 dark:text-[#ce9178]">&quot;ES&quot;</span>, footprint_type=<span class="text-orange-700 dark:text-[#ce9178]">&quot;water&quot;</span>),
    )
    <span class="text-yellow-700 dark:text-[#dcdcaa]">print</span>(carbon[<span class="text-green-800 dark:text-[#b5cea8]">0</span>], water[<span class="text-green-800 dark:text-[#b5cea8]">0</span>], sep=<span class="text-orange-700 dark:text-[#ce9178]">&quot;\n&quot;</span>)

asyncio.<span class="text-yellow-700 dark:text-[#dcdcaa]">run</span>(<span class="text-yellow-700 dark:text-[#dcdcaa]">main</span>())</pre>
                </div>
                <!-- Terminal panel -->
                <div class="border-t border-gray-200/60 dark:border-white/10 bg-white/40 dark:bg-gray-900/40">
                  <div class="flex gap-5 px-4 pt-2 text-[11px] uppercase tracking-wide text-gray-500 dark:text-gray-500">
                    <span>Problems</span>
                    <span>Output</span>
                    <span class="text-gray-800 dark:text-gray-200 border-b border-primary-500 pb-1">
                      Terminal
                    </span>
                  </div>
                  <div class="px-4 py-3.5 overflow-x-auto">
                    <pre class="text-gray-700 dark:text-[#cccccc] leading-[22px] min-h-[110px]"><span class="text-accent-600 dark:text-accent-400">$</span> python async_example.py
  &#123;&#x27;footprint_type&#x27;: &#x27;carbon&#x27;, &#x27;scope&#x27;: &#x27;life-cycle&#x27;, &#x27;zone&#x27;: &#x27;ES&#x27;,
   &#x27;unit&#x27;: &#x27;gCO2/kWh&#x27;, &#x27;value&#x27;: 91.963, &#x27;valid&#x27;: True&#125;
  &#123;&#x27;footprint_type&#x27;: &#x27;water&#x27;, &#x27;scope&#x27;: &#x27;life-cycle&#x27;, &#x27;zone&#x27;: &#x27;ES&#x27;,
   &#x27;unit&#x27;: &#x27;L/kWh&#x27;, &#x27;value&#x27;: 2.9, &#x27;valid&#x27;: True&#125;</pre>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
        <!-- Status bar -->
        <div class="flex items-center justify-between px-3 py-1 bg-primary-600 text-white text-[11px]">
          <span>main</span>
          <span>Python 3.12 &nbsp;·&nbsp; UTF-8</span>
        </div>
      </div>

      <div class="px-4 sm:px-0 order-1 md:order-2">
        <span class="eyebrow">Python Client</span>
        <h2 class="mb-6 bg-gradient-to-r from-gray-900 via-primary-700 to-primary-500 dark:from-white dark:via-primary-200 dark:to-primary-400 bg-clip-text text-transparent">
          Official Python Client
        </h2>
        <p class="text-gray-600 dark:text-gray-300 mb-6 text-justify">
          <code>wattnet-client</code> maps every endpoint of the <strong>Wattnet</strong> API to a
          method and returns tidy <strong>pandas</strong> DataFrames, so you can go from question to
          analysis in a notebook without writing HTTP calls or flattening JSON.
        </p>
        <div class="space-y-4 mb-8">
          <div class="flex items-start">
            <svg
              class="w-5 h-5 text-green-500 mt-1 mr-3 shrink-0"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M5 13l4 4L19 7"
              ></path>
            </svg>
            <p class="text-gray-600 dark:text-gray-300">
              One method per endpoint, DataFrames by default or raw JSON when you need it
            </p>
          </div>
          <div class="flex items-start">
            <svg
              class="w-5 h-5 text-green-500 mt-1 mr-3 shrink-0"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M5 13l4 4L19 7"
              ></path>
            </svg>
            <p class="text-gray-600 dark:text-gray-300">Synchronous and asyncio clients</p>
          </div>
          <div class="flex items-start">
            <svg
              class="w-5 h-5 text-green-500 mt-1 mr-3 shrink-0"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M5 13l4 4L19 7"
              ></path>
            </svg>
            <p class="text-gray-600 dark:text-gray-300">
              Automatic token fetching and renewal with your credentials
            </p>
          </div>
        </div>
        <div class="flex flex-col sm:flex-row gap-4">
          <a
            href="https://pypi.org/project/wattnet-client/"
            target="_blank"
            rel="noopener noreferrer"
            class="btn-primary"
          >
            Install from PyPI
          </a>
          <a
            href="https://github.com/wattnet/wattnet-client-python"
            target="_blank"
            rel="noopener noreferrer"
            class="btn-secondary"
          >
            View on GitHub
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
