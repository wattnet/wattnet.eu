---
import { Image } from 'astro:assets';
import DashboardPreview from '../../assets/dashboard-preview.png';
---

<section class="section bg-white/70 dark:bg-gray-800/50 relative overflow-hidden">
  <div class="container-custom slide-up">
    <!-- Browser mockup -->
    <div class="rounded-xl shadow-2xl overflow-hidden border border-gray-200/60 dark:border-white/10 mx-4 sm:mx-auto">
      <!-- Browser chrome (unified style) -->
      <div class="flex items-center gap-3 px-4 py-3 bg-white/70 dark:bg-gray-900/60 backdrop-blur-md border-b border-gray-200/60 dark:border-white/10 shrink-0">
        <div class="flex gap-1.5 shrink-0">
          <span class="w-3 h-3 rounded-full bg-red-400"></span>
          <span class="w-3 h-3 rounded-full bg-yellow-400"></span>
          <span class="w-3 h-3 rounded-full bg-green-400"></span>
        </div>
        <div class="flex-1 bg-white/80 dark:bg-gray-800/60 backdrop-blur-sm rounded-full h-6 flex items-center px-3 text-xs text-gray-500 dark:text-gray-300 border border-gray-200/50 dark:border-white/10 font-mono truncate">
          https://dashboard.wattnet.eu
        </div>
        <a
          href="https://dashboard.wattnet.eu"
          target="_blank"
          rel="noopener noreferrer"
          class="shrink-0 text-gray-500 dark:text-gray-400 hover:text-gray-700 dark:hover:text-white transition-colors"
          aria-label="Open dashboard in new tab"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="w-4 h-4"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
            />
          </svg>
        </a>
      </div>

      <!-- Content area -->
      <div class="relative h-[480px] flex items-center justify-center overflow-hidden">
        <!-- Blurred background image -->
        <Image
          src={DashboardPreview}
          alt="Preview of the Wattnet dashboard interface"
          class="absolute inset-0 w-full h-full object-cover scale-105 blur-md opacity-70"
          width={1920}
          height={1080}
          quality={80}
          priority
        />

        <!-- Gradient overlay for readability -->
        <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-black/25 to-black/10" />

        <!-- Text overlay -->
        <div class="relative z-10 text-center px-6 max-w-2xl mx-auto">
          <div class="inline-flex items-center gap-2 mb-6 px-4 py-1.5 rounded-full bg-white/15 backdrop-blur-sm border border-white/25 text-white text-sm font-medium">
            <span class="w-2 h-2 rounded-full bg-accent-400 animate-pulse shrink-0"></span>
            Web Dashboard Available Now
          </div>
          <h2 class="text-3xl md:text-4xl font-bold text-white mb-4">
            Visualize All Metrics at a Glance
          </h2>
          <p class="text-white/80 text-base md:text-lg mb-8">
            Explore electricity generation by type, cross-zone flows, carbon and water footprints —
            all in one clear, interactive interface.
          </p>
          <a
            href="https://dashboard.wattnet.eu"
            target="_blank"
            rel="noopener noreferrer"
            class="btn-secondary"
          >
            Discover the dashboard
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
