---
import TeamSection from '../components/Team.astro';
---

<section id="contact" class="section bg-gray-50 dark:bg-gray-800/50">
  <div class="container-custom max-w-6xl mx-auto slide-up">
    <div class="flex flex-col lg:flex-row lg:justify-between lg:items-end gap-4 mb-12 max-w-5.4xl">
      <!-- Texto -->
      <div class="flex-1">
        <span class="inline-block px-4 py-1 rounded-full bg-primary-100 dark:bg-primary-900 text-primary-600 dark:text-primary-300 font-medium text-sm mb-4">
          Get In Touch
        </span>
        <h2 class="mb-6 text-3xl font-bold text-gray-900 dark:text-white">Contact Our Team</h2>
        <p class="text-gray-600 dark:text-gray-300">
          For inquiries, feedback, or support, please contact our team by addressing your message to all of the email addresses listed below. This ensures that your request is received and directed to the appropriate support.
        </p>
      </div>

      <!-- Botón -->
      <div>
        <button
          id="copy-all"
          class="flex items-center gap-2 px-3 py-1 rounded-md bg-gray-200 dark:bg-gray-900 hover:bg-gray-300 dark:hover:bg-gray-800 transition opacity-85"
        >
          <span id="copy-all-icon">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <rect x="3" y="3" width="14" height="14" rx="2" ry="2" stroke-width="2" stroke="currentColor" fill="none"/>
              <rect x="7" y="7" width="14" height="14" rx="2" ry="2" stroke-width="2" stroke="currentColor" fill="none"/>
            </svg>
          </span>
          <span id="copy-all-text">Copy all emails</span>
        </button>
      </div>
    </div>

    <!-- Team Grid Section -->
    <TeamSection />

  </div>
</section>

<script>
  const copyAllBtn = document.getElementById('copy-all');
  const copyAllIcon = document.getElementById('copy-all-icon');
  const copyAllText = document.getElementById('copy-all-text');

  copyAllBtn.addEventListener('click', () => {
    const emails = [
      'iglesias@ifca.es',
      'castrillo@ifca.es',
      'aloga@ifca.es', 
      'obregonm@ifca.es',
      'sainzpardo@ifca.es'
    ].join('; ');

    navigator.clipboard.writeText(emails);

    // Cambiar estado temporal a "Copied"
    copyAllIcon.style.display = 'none';
    copyAllText.textContent = 'All emails copied!';


    setTimeout(() => {
      copyAllIcon.style.display = 'inline-block';
      copyAllText.textContent = 'Copy all emails';
    }, 2000);
  });
</script>
