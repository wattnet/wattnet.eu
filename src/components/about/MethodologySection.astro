---
const stats = [
  { value: '60', label: 'Zones Covered' },
  { value: '15 min', label: 'Temporal Resolution' },
  { value: '72h', label: 'Forecast Horizon' },
  { value: '4', label: 'Environmental Indicators' },
];

const whatWeMeasure = [
  {
    icon: 'M4 4h6v6H4zM14 4h6v6h-6zM4 14h6v6H4zM14 14h6v6h-6z',
    text: 'Four core indicators per zone: carbon footprint, water footprint, water impact, and an overall environmental score.',
  },
  {
    icon: 'M5 7h14m0 0l-3-3m3 3l-3 3M19 17H5m0 0l3-3m-3 3l3 3',
    text: 'Local (generation-based) and global (consumption-based, trade-adjusted) footprints, calculated side by side.',
  },
  {
    icon: 'M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5a2.5 2.5 0 110-5 2.5 2.5 0 010 5z',
    text: 'Reported at the most granular level available, usually a bidding zone or control area, since country-wide averages can hide real differences between regions.',
  },
];

const howWeCalculate = [
  {
    icon: 'M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z',
    text: 'Emission and water-use factors sourced from recognized bodies like the IPCC and UNECE, not estimated in-house.',
  },
  {
    icon: 'M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z',
    text: 'Both operational and life-cycle impact are counted, from daily running to manufacturing and decommissioning.',
  },
  {
    icon: 'M22 12h-4l-3 9L9 3l-3 9H2',
    text: 'Built on the same flow-tracing pipeline described above, refreshed continuously as new grid data arrives.',
  },
];
---

<section class="section bg-white/70 dark:bg-gray-800/50 relative overflow-hidden">
  <div class="container-custom slide-up max-w-5xl mx-auto">
    <div class="max-w-3xl mx-auto text-center mb-10">
      <span class="eyebrow">Under the Hood</span>
      <h2 class="mb-6 bg-gradient-to-r from-gray-900 via-primary-700 to-primary-500 dark:from-white dark:via-primary-200 dark:to-primary-400 bg-clip-text text-transparent">
        What the Figures Actually Represent
      </h2>
      <p class="text-gray-600 dark:text-gray-300">
        Not every footprint number is calculated the same way. Two zones with identical generation
        mixes can end up with different figures once trade, sourcing, and life-cycle scope are taken
        into account.
      </p>
    </div>

    <div class="grid grid-cols-2 md:grid-cols-4 divide-x divide-y md:divide-y-0 divide-secondary-200/60 dark:divide-secondary-800/60 border-y border-secondary-200/60 dark:border-secondary-800/60 bg-gray-100 dark:bg-gray-900/40 mb-16">
      {stats.map((stat) => (
        <div class="py-6 sm:py-8 text-center">
          <p class="text-3xl sm:text-4xl font-bold bg-gradient-to-r from-primary-600 to-accent-500 dark:from-primary-400 dark:to-accent-400 bg-clip-text text-transparent mb-1">
            {stat.value}
          </p>
          <p class="text-xs sm:text-sm font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wide">
            {stat.label.split(' ').map((word, i) => (
              <>
                {i > 0 && <br />}
                {word}
              </>
            ))}
          </p>
        </div>
      ))}
    </div>

    <div class="grid md:grid-cols-2 md:divide-x divide-secondary-200/60 dark:divide-secondary-800/60 gap-y-10 mb-14">
      <div class="md:pr-12">
        <h3 class="text-xs font-semibold uppercase tracking-widest text-primary-600 dark:text-primary-400 mb-6">
          What We Measure
        </h3>
        <ul class="space-y-6">
          {whatWeMeasure.map((item) => (
            <li class="flex items-start gap-4">
              <svg
                class="w-6 h-6 shrink-0 mt-0.5 text-primary-500 dark:text-primary-400"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="1.5"
                  d={item.icon}
                />
              </svg>
              <span class="text-base text-gray-700 dark:text-gray-200">{item.text}</span>
            </li>
          ))}
        </ul>
      </div>

      <div class="md:pl-12">
        <h3 class="text-xs font-semibold uppercase tracking-widest text-accent-600 dark:text-accent-400 mb-6">
          How We Calculate It
        </h3>
        <ul class="space-y-6">
          {howWeCalculate.map((item) => (
            <li class="flex items-start gap-4">
              <svg
                class="w-6 h-6 shrink-0 mt-0.5 text-accent-600 dark:text-accent-400"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="1.5"
                  d={item.icon}
                />
              </svg>
              <span class="text-base text-gray-700 dark:text-gray-200">{item.text}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <div class="text-center">
      <a
        href="/resources"
        class="inline-flex items-center font-semibold text-primary-600 dark:text-primary-400 hover:underline underline-offset-2"
      >
        Read the full methodology paper
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="h-4 w-4 ml-1.5"
          viewBox="0 0 20 20"
          fill="currentColor"
        >
          <path
            fill-rule="evenodd"
            d="M10.293 5.293a1 1 0 011.414 0l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414-1.414L12.586 11H5a1 1 0 110-2h7.586l-2.293-2.293a1 1 0 010-1.414z"
            clip-rule="evenodd"
          />
        </svg>
      </a>
    </div>
  </div>
</section>
