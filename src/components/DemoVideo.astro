---
const videoId = "omhgc62hVQ4";
---
<section class="section bg-white/70 dark:bg-gray-800/50">
  <div class="container-custom slide-up">
    <div class="rounded-xl shadow-2xl overflow-hidden border border-gray-200/60 dark:border-white/10 flex flex-col">
      <!-- Browser chrome -->
      <div class="flex items-center gap-3 px-4 py-3 bg-white/70 dark:bg-gray-900/60 backdrop-blur-md border-b border-gray-200/60 dark:border-white/10 shrink-0">
        <div class="flex gap-1.5 shrink-0">
          <span class="w-3 h-3 rounded-full bg-red-400"></span>
          <span class="w-3 h-3 rounded-full bg-yellow-400"></span>
          <span class="w-3 h-3 rounded-full bg-green-400"></span>
        </div>
        <div class="flex-1 bg-white/50 dark:bg-gray-800/50 backdrop-blur-sm rounded-full h-6 flex items-center px-3 text-xs text-gray-500 dark:text-gray-300 border border-gray-200/50 dark:border-white/10 font-mono truncate">
          https://www.youtube.com/watch?v={videoId}
        </div>
        <a
          href={`https://www.youtube.com/watch?v=${videoId}`}
          target="_blank"
          rel="noopener noreferrer"
          class="shrink-0 text-gray-500 dark:text-gray-400 hover:text-gray-700 dark:hover:text-white transition-colors"
          aria-label="Open video on YouTube"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
        </a>
      </div>

      <!-- Video content -->
      <div id="video-container" data-video-id={videoId} class="relative aspect-video bg-black">
        <button
          id="video-play-btn"
          type="button"
          class="absolute inset-0 w-full h-full group"
          aria-label="Play Wattnet dashboard demo video"
        >
          <img
            src={`https://img.youtube.com/vi/${videoId}/maxresdefault.jpg`}
            alt="Wattnet dashboard demo video"
            class="w-full h-full object-cover"
            loading="lazy"
          />
          <span class="absolute inset-0 flex items-center justify-center">
            <span class="relative flex items-center justify-center group-hover:scale-110 transition-transform duration-300">
              <span class="absolute w-24 h-24 rounded-full bg-accent-400/30 blur-2xl"></span>
              <span class="relative w-20 h-20 rounded-full ring-2 ring-accent-400/80 shadow-[0_0_20px_rgba(148,206,36,0.6)] group-hover:ring-accent-300 group-hover:shadow-[0_0_32px_rgba(148,206,36,0.9)] transition-all duration-300 flex items-center justify-center">
                <svg class="w-11 h-11 text-white" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M8 5v14l11-7z" />
                </svg>
              </span>
            </span>
          </span>
        </button>
      </div>
    </div>
  </div>
</section>

<script>
  const videoContainer = document.getElementById('video-container') as HTMLElement | null;
  const videoPlayBtn = document.getElementById('video-play-btn') as HTMLButtonElement | null;

  videoPlayBtn?.addEventListener('click', () => {
    const videoId = videoContainer?.dataset.videoId;
    if (!videoContainer || !videoId) return;

    const videoIframe = document.createElement('iframe');
    videoIframe.src = `https://www.youtube-nocookie.com/embed/${videoId}?autoplay=1`;
    videoIframe.title = 'Wattnet Dashboard Demo Video';
    videoIframe.className = 'w-full h-full border-0';
    videoIframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
    videoIframe.allowFullscreen = true;

    videoContainer.replaceChildren(videoIframe);
  });
</script>
