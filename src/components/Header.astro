---
const pages = [
  { name: "Features", href: "/features" },
  { name: "Services", href: "/services" },
  { name: "Resources", href: "/resources" },
  { name: "Docs", href: "https://docs.wattnet.eu", external: true },
  { name: "Contact", href: "/contact" },
];

import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import wattnetLogo from "/src/assets/logos/wattnet/wattnet-logo-icon-color-transparent.png";
---

<header
  x-data="{ open: false }"
  class="sticky top-0 z-50
        bg-white/80 dark:bg-secondary-950/80
        backdrop-blur-xs
        transition-colors duration-300
        shadow-sm"
>
  <!-- Top navbar -->
  <div class="container-custom slide-up flex items-center justify-between px-4 sm:px-6 py-3">
    <!-- Logo -->
    <a href="/" class="flex items-center" aria-label="Go to homepage">
      <Image
        src={wattnetLogo}
        alt="Wattnet logo"
        class="h-10 w-auto"
        width={500}
        height={500}
        loading="eager"
      />
      <span class="ml-2 text-2xl font-display font-bold text-secondary-900 dark:text-white">
        wattnet
      </span>
    </a>

    <!-- Desktop navigation -->
    <nav class="hidden lg:flex items-center space-x-8 text-lg">
      {pages.map((page) => (
        <a
          href={page.href}
          target={page.external ? "_blank" : undefined}
          rel={page.external ? "noopener noreferrer" : undefined}
          class="relative font-medium transition-colors
                text-secondary-600 hover:text-primary-600
                dark:text-secondary-300 dark:hover:text-primary-400
                after:absolute after:left-0 after:-bottom-0.75
                after:h-[2px] after:w-0 after:bg-primary-600
                dark:after:bg-primary-400
                after:transition-all after:duration-200
                hover:after:w-full"
      >
          {page.name}
        </a>
      ))}
    </nav>

    <!-- Right actions -->
    <div class="flex items-center space-x-4">
      <!-- GitHub -->
      <a
        href="https://github.com/wattnet"
        target="_blank"
        rel="noopener noreferrer"
        class="p-2 rounded-full transition-colors
              text-secondary-500 hover:text-primary-500
              dark:text-secondary-400 dark:hover:text-primary-400"
        aria-label="Go to Wattnet GitHub organization"
      >
        <Icon name="simple-icons:github" class="h-5 w-5" />
      </a>

      <!-- Docker Hub -->
      <a
        href="https://hub.docker.com/u/wattnet"
        target="_blank"
        rel="noopener noreferrer"
        class="p-2 rounded-full transition-colors
              text-secondary-500 hover:text-primary-500
              dark:text-secondary-400 dark:hover:text-primary-400"
        aria-label="Go to Wattnet Docker Hub"
      >
        <Icon name="simple-icons:docker" class="h-5 w-5" />
      </a>

      <button
        x-on:click="darkMode = !darkMode" 
        class="p-2 rounded-full text-secondary-500 hover:text-secondary-700 dark:text-secondary-400 dark:hover:text-secondary-200 focus:outline-hidden focus:ring-2 focus:ring-primary-500"
        aria-label="Toggle dark mode"
      >
        <svg x-show="!darkMode" xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
        </svg>
        <svg x-show="darkMode" xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
        </svg>
      </button>

      <!-- Desktop CTA -->
      <a
        href="https://dashboard.wattnet.eu"
        target="_blank"
        rel="noopener noreferrer"
        class="hidden lg:inline-flex btn-primary"
      >
        Get Started
      </a>

      <!-- Mobile menu button -->
      <button
        @click="open = !open"
        class="lg:hidden p-2 rounded-md transition-colors
              text-secondary-600 hover:text-secondary-900
              dark:text-secondary-300 dark:hover:text-white
              focus:outline-hidden focus:ring-2 focus:ring-primary-500"
        aria-label="Toggle menu"
      >
        <svg
          x-show="!open"
          xmlns="http://www.w3.org/2000/svg"
          class="h-6 w-6"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
        >
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
            d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg
          x-show="open"
          xmlns="http://www.w3.org/2000/svg"
          class="h-6 w-6"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
        >
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
            d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile expanded menu -->
  <div
    x-show="open"
    x-transition
    x-cloak
    class="lg:hidden w-full
          border-t border-secondary-200/60 dark:border-secondary-800/60"
  >
    <nav class="flex flex-col divide-y divide-secondary-200/50 dark:divide-secondary-800/50">
      {pages.map((page) => (
        <a
          href={page.href}
          target={page.external ? "_blank" : undefined}
          rel={page.external ? "noopener noreferrer" : undefined}
          @click="open = false"
          class="px-6 py-2.5
                text-base font-medium
                bg-transparent hover:bg-transparent focus:bg-transparent active:bg-transparent
                text-secondary-700 hover:text-primary-600
                dark:text-secondary-200 dark:hover:text-primary-400
                transition-colors"
        >
          {page.name}
        </a>
      ))}

      <!-- CTA -->
      <div class="px-6 py-4">
        <a
          href="https://dashboard.wattnet.eu"
          target="_blank"
          rel="noopener noreferrer"
          @click="open = false"
          class="btn-primary w-full justify-center"
        >
          Get Started
        </a>
      </div>
    </nav>
  </div>
</header>
