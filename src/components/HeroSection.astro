---
interface Props {
  title: string;
  highlightText?: string;
  description: string;
}

const { title, highlightText, description } = Astro.props;

let titleStart = title;
let titleEnd = "";

if (highlightText) {
  const titleParts = title.split(highlightText);
  if (titleParts.length > 1) {
    titleStart = titleParts[0];
    titleEnd = titleParts[1];
  }
}
---

<section class="relative overflow-hidden min-h-[40vh] flex items-center py-20 md:py-28">

  <div class="absolute inset-0 z-0 opacity-30">
    <div class="absolute inset-0 bg-grid-pattern"></div>
  </div>

  <div class="container-custom relative z-10 w-full">
    <div class="text-center max-w-3xl mx-auto px-4">

      <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold mb-5 leading-tight animate-slide-down">
        {highlightText ? (
          <>
            <span class="text-gray-900 dark:text-white">{titleStart}</span><span class="bg-gradient-to-r from-primary-700 to-accent-600 dark:from-primary-400 dark:to-accent-500 bg-clip-text text-transparent">{highlightText}</span><span class="text-gray-900 dark:text-white">{titleEnd}</span>
          </>
        ) : (
          <span class="bg-gradient-to-r from-gray-900 via-primary-800 to-primary-600 dark:from-white dark:via-primary-300 dark:to-primary-500 bg-clip-text text-transparent">{title}</span>
        )}
      </h1>

      <p class="text-lg md:text-xl text-gray-600 dark:text-gray-300 max-w-2xl mx-auto animate-slide-up" style="animation-delay: 150ms">
        {description}
      </p>

    </div>
  </div>
</section>
