---
import PublicationClient from "../components/PublicationClient.tsx";
import zenodoLogo from '../assets/logos/external/zenodo.svg';
import arxivLogo from '../assets/logos/external/arxiv.svg';


const datasets = [
  {
    title: "Dataset for \"Wattnet: matching electricity consumption with low-carbon, low-water footprint energy supply\"",
    description: "This entry contains the data used to produce the manuscript entitled \"Wattnet: matching electricity consumption with low-carbon, low-water footprint energy supply\" with DOI 10.5281/zenodo.17404776.",
    year: 2025,
    type: "Dataset",
    publisher: "Zenodo",
    doi: "10.5281/zenodo.17974446",
    authors: [
      { name: "Iglesias Blanco, Jaime", orcid: "https://orcid.org/0009-0007-7761-5600" },
      { name: "Castrillo Melguizo, Maria", orcid: "https://orcid.org/0000-0001-7033-6907" },
      { name: "López García, Álvaro", orcid: "https://orcid.org/0000-0002-0013-4602" },
    ],
    links: [
      { title: "Zenodo", url: "https://zenodo.org/records/17974446", color: "text-blue-600 dark:text-blue-400", icon: zenodoLogo.src },
    ],
    tags: [
      { title: "Restricted", icon: "Ban", color: "text-red-600 dark:text-red-400 bg-red-100 dark:bg-red-800/30" },
    ],
  },
];
---

<section id="datasets" class="section bg-gray-50 dark:bg-gray-800/10 relative overflow-hidden">
  <div class="container-custom slide-up">

    <!-- Header de la sección -->
    <div class="flex flex-col lg:flex-row lg:justify-between lg:items-end gap-4 mb-12 max-w-6xl">
      <div class="flex-1">
        <span class="inline-block px-4 py-1 rounded-full bg-primary-100 dark:bg-primary-900 text-primary-600 dark:text-primary-300 font-medium text-sm mb-4">
          Open Data 
        </span>
        <h2 class="mb-6 text-3xl font-bold bg-gradient-to-r from-gray-900 via-primary-700 to-primary-500 dark:from-white dark:via-primary-200 dark:to-primary-400 bg-clip-text text-transparent">Our Datasets</h2>
        <p class="text-gray-600 dark:text-gray-300">
          A collection of open energy datasets that provide comprehensive information on electricity consumption patterns, generation mixes, carbon footprints, and water footprints across Europe, enabling researchers, policymakers, and industry stakeholders to analyze and optimize energy usage for sustainability.
        </p>
      </div>
    </div>

    <!-- Interactive Preact component -->
    <PublicationClient client:load publications={datasets} />
  </div>
</section>
