---
import LottieBackground from '../components/LottieBackground.astro';
import { Image } from "astro:assets";
import GreenDIGITLogo from "/src/assets/logos/external/greendigit-trusted.png";
import AI4EOSCLogo from "/src/assets/logos/external/ai4eosc-trusted.png";
---
<section class="relative -mt-18 pt-32 pb-20 md:pt-40 overflow-hidden h-screen">

  <!-- Lottie Animation Background -->
  <LottieBackground />

  <div class="container-custom slide-up relative z-10 h-full flex flex-col justify-center">
    <div class="grid md:grid-cols-1 gap-12 items-center">
      <div>
        <h1 class="mb-6 text-secondary-900 dark:text-white text-3xl md:text-6xl">
          <span class="text-primary-700 dark:text-primary-400">
            Explore environmental <span class="hidden md:inline"><br></span> footprint of electricity <span class="hidden md:inline"><br></span> powered by open data
          </span>
        </h1>
        <br>
        <div class="w-full md:w-1/2 flex flex-col gap-4 mb-6">
          <h4 class="text-xl md:text-2xl text-gray-700 dark:text-gray-300">
            Access real-time, historical, and forecasted data <span class="hidden xl:inline"><br></span> on the carbon and water impact of electricity consumption across Europe.
          </h4>
          <br>
          <h5 class="text-lg md:text-2xl text-gray-700 dark:text-gray-300">
            Designed for data-driven research, supporting informed decision-making for a more sustainable future.
          </h5>
        </div>
        <div class="flex flex-col md:flex-row gap-4 w-full mt-16">
          <a href="https://dashboard.wattnet.eu" target="_blank" rel="noopener noreferrer" class="btn-primary w-full md:w-auto text-lg">
              <span class="inline-flex items-center gap-1">
                Discover&nbsp;
                <span class="text-xl font-extrabold text-primary leading-none">
                  wattnet
                </span>
              </span>
            </a>
          <a href="#trusted" class="btn-outline text-lg w-full md:w-auto text-center">
            Read more
          </a>
          <a href="/contact" class="btn-outline text-lg w-full md:w-auto text-center">
            Contact us
          </a>
        </div>
      </div>
    </div>
  </div>
  <div id="trusted"></div>
</section>

  <!-- Teal section at the bottom with Trusted By -->
<div class="relative bg-[#94CE24] py-12 md:py-16">
  <div class="container-custom slide-up">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      <div>
        <h4 class="text-3xl md:text-4xl text-[#0B1C38] dark:text-[#0B1C38]">
          Transforming energy data <span class="hidden xl:inline"><br></span>  into actionable insights for building a greener Europe.
        </h4>
      </div>
      
      <div class="flex flex-col items-start md:items-end justify-center">
        <p class="text-sm uppercase tracking-wider text-[#0B1C38] dark:text-[#0B1C38] font-medium mb-4">TRUSTED BY</p>
        <div class="flex flex-wrap justify-start md:justify-end gap-x-12 gap-y-6 items-center">
          <a href="https://ai4eosc.eu/" target="_blank" aria-label="AI4EOSC Project">
            <Image src={AI4EOSCLogo} alt="AI4EOSC Logo" class="h-14 w-auto filter invert brightness-0 grayscale" width={500} height={500} />
          </a>
          <a href="https://greendigit-project.eu/" target="_blank" aria-label="GreenDIGIT Project">
            <Image src={GreenDIGITLogo} alt="GreenDigit Logo" class="h-11 w-auto filter invert brightness-0 grayscale" width={500} height={500} />
          </a>
        </div>
      </div>
    </div>
  </div>
</div>


<style>
  /* Add keyframes for additional animations if needed */
  @keyframes float {
    0% { transform: translateY(0px); }
    50% { transform: translateY(-10px); }
    100% { transform: translateY(0px); }
  }

  .lottie-bg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
</style>
