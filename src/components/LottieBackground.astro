<div class="lottie-container">
  <canvas id="hero-lottie" class="lottie"></canvas>
</div>

<script>
  import { DotLottie } from '@lottiefiles/dotlottie-web';

  function initLottie() {
    const canvas = document.getElementById('hero-lottie') as HTMLCanvasElement | null;
    if (!canvas) return;

    // Match canvas resolution to its display size for crisp rendering
    const dpr = window.devicePixelRatio || 1;
    const rect = canvas.getBoundingClientRect();
    canvas.width = rect.width * dpr;
    canvas.height = rect.height * dpr;

    new DotLottie({
      canvas,
      src: '/animations/wattnet-hero-full.lottie',
      autoplay: true,
      loop: true,
      speed: 0.5,
      mode: 'bounce',
    });
  }

  if ('requestIdleCallback' in window) {
    requestIdleCallback(initLottie, { timeout: 2000 });
  } else {
    setTimeout(initLottie, 200);
  }
</script>

<style>
  .lottie-container {
    position: absolute;
    top: 0;
    right: -10%;
    width: 107%;
    height: 107%;
    overflow: hidden;
    z-index: 0;
    pointer-events: none;
  }

  .lottie {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
  }

  @media (max-width: 768px) {
    .lottie-container {
      display: none;
    }
  }
</style>
