---
const dashboardBase = "https://dashboard.wattnet.eu/map";
const dashboardUrl = dashboardBase;
---
<section class="section bg-gray-50 dark:bg-gray-900/10">
  <div class="container-custom slide-up">
    <div class="grid lg:[grid-template-columns:48fr_52fr] gap-8 lg:gap-12 items-stretch">

      <!-- Left: text + CTA -->
      <div class="flex flex-col justify-center text-left">
        <span class="inline-block self-start px-4 py-1 rounded-full bg-primary-100 dark:bg-primary-900 text-primary-600 dark:text-primary-300 font-medium text-sm mb-6">
          Live Demo
        </span>
        <h2 class="text-3xl lg:text-4xl font-bold mb-4 bg-gradient-to-r from-gray-900 via-primary-700 to-primary-500 dark:from-white dark:via-primary-200 dark:to-primary-400 bg-clip-text text-transparent">
          Explore the Wattnet Dashboard
        </h2>
        <p class="text-gray-600 dark:text-gray-300 mb-6">
          Explore the environmental footprint of electricity consumption across Europe through an interactive map. Wattnet provides transparent, open-source indicators to support research, analysis, and sustainability decision-making.
        </p>
        <ul class="space-y-3 mb-8 text-left">
          <li class="flex items-start gap-3 text-gray-600 dark:text-gray-300">
            <svg class="w-5 h-5 mt-0.5 shrink-0 text-primary-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
            </svg>
            <span>Carbon footprint of electricity consumption per European grid zone, based on the actual generation mix in real time.</span>
          </li>
          <li class="flex items-start gap-3 text-gray-600 dark:text-gray-300">
            <svg class="w-5 h-5 mt-0.5 shrink-0 text-primary-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
            </svg>
            <span>Water footprint associated with electricity generation, covering both consumptive and withdrawal water use across technologies.</span>
          </li>
          <li class="flex items-start gap-3 text-gray-600 dark:text-gray-300">
            <svg class="w-5 h-5 mt-0.5 shrink-0 text-primary-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
            </svg>
            <span>Water impact indicator that weights water footprint by the local availability of freshwater resources in each region.</span>
          </li>
          <li class="flex items-start gap-3 text-gray-600 dark:text-gray-300">
            <svg class="w-5 h-5 mt-0.5 shrink-0 text-primary-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
            </svg>
            <span>Green Score — a multidimensional environmental indicator that combines carbon footprint and water impact into a single comparable metric.</span>
          </li>
        </ul>
        <div class="self-start flex flex-wrap gap-4">
          <a
            href={dashboardUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="btn-primary inline-flex items-center gap-2"
          >
            Open Web Dashboard
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
          </a>
          <a href="/services" class="btn-outline inline-flex items-center gap-2">
            Discover more services
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
            </svg>
          </a>
        </div>
      </div>

      <!-- Right: browser mockup + iframe -->
      <div class="rounded-xl shadow-2xl overflow-hidden border border-gray-200/60 dark:border-white/10 flex flex-col h-[480px] md:h-[560px] lg:h-auto">
        <!-- Browser chrome -->
        <div class="flex items-center gap-3 px-4 py-3 bg-white/70 dark:bg-gray-900/60 backdrop-blur-md border-b border-gray-200/60 dark:border-white/10 shrink-0">
          <div class="flex gap-1.5 shrink-0">
            <span class="w-3 h-3 rounded-full bg-red-400"></span>
            <span class="w-3 h-3 rounded-full bg-yellow-400"></span>
            <span class="w-3 h-3 rounded-full bg-green-400"></span>
          </div>
          <div class="flex-1 bg-white/80 dark:bg-gray-800/60 backdrop-blur-sm rounded-full h-6 flex items-center px-3 text-xs text-gray-500 dark:text-gray-300 border border-gray-200/50 dark:border-white/10 font-mono truncate">
            https://dashboard.wattnet.eu/map
          </div>
          <a
            href={dashboardUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="shrink-0 text-gray-500 dark:text-gray-400 hover:text-gray-700 dark:hover:text-white transition-colors"
            aria-label="Open dashboard in new tab"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
          </a>
        </div>

        <!-- iframe wrapper -->
        <div class="relative bg-gray-100 dark:bg-gray-800 flex-1 min-h-0">
          <!-- Loading skeleton -->
          <div id="iframe-skeleton" class="absolute inset-0 flex items-center justify-center bg-gray-100 dark:bg-gray-800">
            <svg class="w-10 h-10 text-gray-300 dark:text-gray-600 animate-spin" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
              <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
              <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v4a4 4 0 00-4 4H4z"></path>
            </svg>
          </div>
          <iframe
            id="dashboard-iframe"
            src=""
            title="Wattnet Live Web Dashboard"
            loading="eager"
            class="w-full h-full border-0 opacity-0 transition-opacity duration-500"
          ></iframe>
        </div>
      </div>

    </div>
  </div>
</section>

<script>
  const iframe = document.getElementById('dashboard-iframe') as HTMLIFrameElement;
  const skeleton = document.getElementById('iframe-skeleton') as HTMLElement;

  function getTheme(): string {
    return document.documentElement.classList.contains('dark') ? 'dark' : 'light';
  }

  function buildIframeSrc(theme: string): string {
    return `https://dashboard.wattnet.eu/map?theme=${theme}&lat=51&lng=12&zoom=1`;
  }

  if (iframe && skeleton) {
    iframe.src = buildIframeSrc(getTheme());

    iframe.addEventListener('load', () => {
      skeleton.style.display = 'none';
      iframe.style.opacity = '1';
    });

    const observer = new MutationObserver(() => {
      const newSrc = buildIframeSrc(getTheme());
      if (iframe.src !== newSrc) {
        skeleton.style.display = 'flex';
        iframe.style.opacity = '0';
        iframe.src = newSrc;
      }
    });

    observer.observe(document.documentElement, {
      attributes: true,
      attributeFilter: ['class'],
    });
  }
</script>
