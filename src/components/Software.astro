---
import SoftwareClient from './SoftwareClient';
---

<section id="software" class="section bg-white/70 dark:bg-gray-800/50 relative overflow-hidden">
  <div class="container-custom slide-up">

    <!-- Header de la sección -->
    <div class="flex flex-col lg:flex-row lg:justify-between lg:items-end gap-4 mb-12 max-w-5.4xl">
      <div class="flex-1">
        <span class="inline-block px-4 py-1 rounded-full bg-primary-100 dark:bg-primary-900 text-primary-600 dark:text-primary-300 font-medium text-sm mb-4">
          Open Source
        </span>
        <h2 class="mb-6 text-3xl font-bold bg-gradient-to-r from-gray-900 via-primary-700 to-primary-500 dark:from-white dark:via-primary-200 dark:to-primary-400 bg-clip-text text-transparent">Our Code Repositories</h2>
        <p class="text-gray-600 dark:text-gray-300">
          Dive into our open-source projects on GitHub. Every repository comes with code, documentation, and resources, enabling researchers and developers to collaborate, innovate, and leverage our work seamlessly.
        </p>
      </div>
    </div>

    <!-- Repositorios -->
    <SoftwareClient client:load />

  </div>
</section>
