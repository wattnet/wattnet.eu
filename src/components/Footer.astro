---
import { Image } from "astro:assets";
import wattnetLogo from "/src/assets/logos/wattnet/wattnet-logo-icon-color-transparent.png";
import EUFundingLogo from "/src/assets/logos/external/EN_FundedbytheEU_RGB_POS.png"
import GreenDIGITLogo from "/src/assets/logos/external/GreenDIGIT logo color horizontal2.png"

const currentYear = new Date().getFullYear();
---

<footer class="bg-gray-900 text-white pt-16 pb-8">
  <div class="container-custom slide-up">
    <div class="grid md:grid-cols-7 gap-8 mb-4">
      <div class="md:col-span-4">
        <a href="/" class="flex items-center mb-4" aria-label="Go to homepage">
          <!-- Logo optimizado -->
          <Image 
            src={wattnetLogo}
            alt="Wattnet Logo"
            class="h-12 w-auto"
            width={500}
            height={500}
            loading="lazy"
          />
          <span class="ml-2 text-3xl font-display font-semibold text-white">wattnet</span>
        </a>

        <h6 class="text-gray-400 text-base mb-3">
          An open-source service for tracking the environmental footprint of electricity across Europe. 
        </h6>

        <ul class="text-gray-400 text-sm list-disc list-inside space-y-1">
          <li>
            A service provided by 
            <a href="https://www.csic.es" target="_blank" rel="noopener noreferrer" class="text-blue-400 hover:underline">
              Spanish National Research Council (CSIC)
            </a>
          </li>
          <li>
            Deployed on the Scientific Cloud at 
            <a href="https://ifca.unican.es/" target="_blank" rel="noopener noreferrer" class="text-blue-400 hover:underline">
              Institute of Physics of Cantabria (IFCA)
            </a>
          </li>
          <li>
            Developed by the 
            <a href="https://advancedcomputing.ifca.es" target="_blank" rel="noopener noreferrer" class="text-blue-400 hover:underline">
              IFCA Advanced Computing and e-Science Group
            </a>
          </li>
        </ul>
      </div>

      <div class="md:col-span-3">
        <h3 class="text-lg font-semibold mb-4">Funding and acknowledgments</h3>
        <p class="text-gray-400 mb-4 text-sm leading-relaxed">
          This work is funded from the European Union’s Horizon Europe research and innovation
          programme through the
          <a href="https://greendigit-project.eu/" target="_blank" rel="noopener noreferrer" class="text-blue-400 hover:underline">
            GreenDIGIT project</a>, under the grant agreement No.<a href="https://cordis.europa.eu/project/id/101131207" target="_blank" rel="noopener noreferrer" class="text-blue-400 hover:underline">101131207</a>.
        </p>
        <div class="flex flex-wrap justify-between items-center w-full gap-4">
          <div class="flex-1 min-w-[120px] max-w-[48%]">
            <Image
              src={EUFundingLogo}
              alt="European Union Funding"
              class="w-full h-auto"
              height={500}
            />
          </div>
          <div class="flex-1 min-w-[120px] max-w-[45%]">
            <Image
              src={GreenDIGITLogo}
              alt="Wattnet Logo"
              class="w-full h-auto"
              height={500}
            />
          </div>
        </div>
      </div>
    </div>

    <div class="border-t border-gray-800 pt-6 mt-8 mb-6 flex flex-col md:flex-row justify-between items-center gap-4">

      <!-- Left: GitHub & Docker Hub (stacked) -->
      <div class="flex flex-col gap-1">
        <a href="https://github.com/wattnet" target="_blank" rel="noopener noreferrer"
          class="flex items-center gap-2 text-gray-400 hover:text-accent-500 transition-colors">
          <svg class="w-4 h-4 shrink-0" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 .5C5.65.5.5 5.65.5 12.02c0 5.1 3.3 9.43 7.88 10.96.58.1.79-.25.79-.56v-2.02c-3.2.7-3.88-1.55-3.88-1.55-.52-1.34-1.28-1.7-1.28-1.7-1.04-.72.08-.7.08-.7 1.15.08 1.76 1.17 1.76 1.17 1.02 1.76 2.68 1.25 3.33.96.1-.74.4-1.25.73-1.54-2.56-.29-5.25-1.29-5.25-5.74 0-1.27.45-2.32 1.18-3.14-.12-.29-.51-1.46.11-3.05 0 0 .96-.31 3.14 1.2a10.9 10.9 0 0 1 5.72 0c2.18-1.51 3.14-1.2 3.14-1.2.62 1.59.23 2.76.11 3.05.73.82 1.18 1.87 1.18 3.14 0 4.46-2.69 5.44-5.26 5.73.42.36.8 1.07.8 2.17v3.23c0 .31.2.67.8.56A10.98 10.98 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5z"/>
          </svg>
          <span class="text-sm">github.com/wattnet</span>
        </a>
        <a href="https://hub.docker.com/u/wattnet" target="_blank" rel="noopener noreferrer"
          class="flex items-center gap-2 text-gray-400 hover:text-accent-500 transition-colors">
          <svg class="w-4 h-4 shrink-0" fill="currentColor" viewBox="0 0 24 24">
            <path d="M13.983 11.078h2.119a.186.186 0 0 0 .186-.185V9.006a.186.186 0 0 0-.186-.186h-2.119a.185.185 0 0 0-.185.185v1.888c0 .102.083.185.185.185m-2.954-5.43h2.118a.186.186 0 0 0 .186-.186V3.574a.186.186 0 0 0-.186-.185h-2.118a.185.185 0 0 0-.185.185v1.888c0 .102.082.185.185.185m0 2.716h2.118a.187.187 0 0 0 .186-.186V6.29a.186.186 0 0 0-.186-.185h-2.118a.185.185 0 0 0-.185.185v1.887c0 .102.082.185.185.186m-2.93 0h2.12a.186.186 0 0 0 .184-.186V6.29a.185.185 0 0 0-.185-.185H8.1a.185.185 0 0 0-.185.185v1.887c0 .102.083.185.185.186m-2.964 0h2.119a.186.186 0 0 0 .185-.186V6.29a.185.185 0 0 0-.185-.185H5.136a.186.186 0 0 0-.186.185v1.887c0 .102.084.185.186.186m5.893 2.715h2.118a.186.186 0 0 0 .186-.185V9.006a.186.186 0 0 0-.186-.186h-2.118a.185.185 0 0 0-.185.185v1.888c0 .102.082.185.185.185m-2.93 0h2.12a.185.185 0 0 0 .184-.185V9.006a.185.185 0 0 0-.184-.186h-2.12a.185.185 0 0 0-.184.185v1.888c0 .102.083.185.185.185m-2.964 0h2.119a.185.185 0 0 0 .185-.185V9.006a.185.185 0 0 0-.184-.186h-2.12a.186.186 0 0 0-.186.185v1.888c0 .102.084.185.186.185m-2.92 0h2.12a.186.186 0 0 0 .184-.185V9.006a.185.185 0 0 0-.184-.186h-2.12a.185.185 0 0 0-.185.185v1.888c0 .102.083.185.185.185M23.763 9.89c-.065-.051-.672-.51-1.954-.51-.338.001-.676.03-1.01.087-.248-1.7-1.653-2.53-1.716-2.566l-.344-.199-.226.327c-.284.438-.49.922-.612 1.43-.23.97-.09 1.882.403 2.661-.595.332-1.55.413-1.744.42H.751a.751.751 0 0 0-.75.748 11.376 11.376 0 0 0 .692 4.062c.545 1.428 1.355 2.48 2.41 3.124 1.18.723 3.1 1.137 5.275 1.137.983.003 1.963-.086 2.93-.266a12.248 12.248 0 0 0 3.823-1.389c.98-.567 1.86-1.288 2.61-2.136 1.252-1.418 1.998-2.997 2.553-4.4h.221c1.372 0 2.215-.549 2.68-1.009.309-.293.55-.65.707-1.046l.098-.288Z"/>
          </svg>
          <span class="text-sm">hub.docker.com/u/wattnet</span>
        </a>
      </div>

      <!-- Right: copyright + licenses -->
      <div class="text-right text-sm text-gray-400 space-y-1">
        <div class="font-semibold">&copy; {currentYear} Spanish National Research Council (CSIC). All rights reserved.</div>
        <div>
          <a href="https://www.apache.org/licenses/LICENSE-2.0" target="_blank" rel="noopener noreferrer" class="hover:text-gray-300 transition-colors">Apache License 2.0</a>
          <span class="mx-1.5">·</span>
          <a href="https://creativecommons.org/licenses/by/4.0/" target="_blank" rel="noopener noreferrer" class="hover:text-gray-300 transition-colors">Creative Commons Attribution 4.0 International</a>
        </div>
      </div>

    </div>

  </div>
</footer>
