---
import Layout from '../layouts/Layout.astro';
import Header from '../components/common/Header.astro';
import Footer from '../components/common/Footer.astro';
import HeroSection from '../components/common/HeroSection.astro';
import TermsContent from '../components/legal/TermsContent.astro';
---

<Layout
  title="Terms of Service | Wattnet"
  description="The terms and conditions governing your access to and use of the Wattnet website, dashboard, and API, including data licensing, acceptable use, and what you can expect from the service."
>
  <Header />
  <main>
    <HeroSection
      title="Terms of Service"
      highlightText="Terms"
      description="The terms and conditions governing your access to and use of the Wattnet website, dashboard, and API — covering data licensing, acceptable use, and what you can expect from the service."
    />

    <TermsContent />
  </main>
  <Footer />
</Layout>
