---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import HeroSection from '../components/HeroSection.astro';
import { Image } from "astro:assets";
import DashboardPreview from '../assets/dashboard-preview.png';
import CallToAction from '../components/CallToAction.astro';
import { Icon } from 'astro-icon/components';
import wattnetLogo from '/src/assets/logos/wattnet/wattnet-logo-icon-color-transparent.png';
---

<Layout
  title="Data Services | Wattnet"
  description="Tools to track and analyze electricity generation, cross-border flows, and carbon and water footprints across Europe, from interactive exploration to automation."
>
  <Header />
  <main>
    <HeroSection
      title="Next-Level Services"
      highlightText="Services"
      description="Track electricity generation, cross-border flows, and the carbon and water footprints of European electricity, with tools built for every workflow, from interactive exploration to automation."
    />

    <!-- Dashboard Preview Section -->
    <section class="section bg-white/70 dark:bg-gray-800/50 relative overflow-hidden">
      <div class="container-custom slide-up">

        <!-- Browser mockup -->
        <div class="rounded-xl shadow-2xl overflow-hidden border border-gray-200/60 dark:border-white/10 mx-4 sm:mx-auto">

          <!-- Browser chrome (unified style) -->
          <div class="flex items-center gap-3 px-4 py-3 bg-white/70 dark:bg-gray-900/60 backdrop-blur-md border-b border-gray-200/60 dark:border-white/10 shrink-0">
            <div class="flex gap-1.5 shrink-0">
              <span class="w-3 h-3 rounded-full bg-red-400"></span>
              <span class="w-3 h-3 rounded-full bg-yellow-400"></span>
              <span class="w-3 h-3 rounded-full bg-green-400"></span>
            </div>
            <div class="flex-1 bg-white/80 dark:bg-gray-800/60 backdrop-blur-sm rounded-full h-6 flex items-center px-3 text-xs text-gray-500 dark:text-gray-300 border border-gray-200/50 dark:border-white/10 font-mono truncate">
              https://dashboard.wattnet.eu
            </div>
            <a
              href="https://dashboard.wattnet.eu"
              target="_blank"
              rel="noopener noreferrer"
              class="shrink-0 text-gray-500 dark:text-gray-400 hover:text-gray-700 dark:hover:text-white transition-colors"
              aria-label="Open dashboard in new tab"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
            </a>
          </div>

          <!-- Content area -->
          <div class="relative h-[480px] flex items-center justify-center overflow-hidden">

            <!-- Blurred background image -->
            <Image
              src={DashboardPreview}
              alt="Preview of the Wattnet dashboard interface"
              class="absolute inset-0 w-full h-full object-cover scale-105 blur-md opacity-70"
              width={1920}
              height={1080}
              quality={80}
              priority
            />

            <!-- Gradient overlay for readability -->
            <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-black/25 to-black/10" />

            <!-- Text overlay -->
            <div class="relative z-10 text-center px-6 max-w-2xl mx-auto">
              <div class="inline-flex items-center gap-2 mb-6 px-4 py-1.5 rounded-full bg-white/15 backdrop-blur-sm border border-white/25 text-white text-sm font-medium">
                <span class="w-2 h-2 rounded-full bg-accent-400 animate-pulse shrink-0"></span>
                Web Dashboard Available Now
              </div>
              <h2 class="text-3xl md:text-4xl font-bold text-white mb-4">
                Visualize All Metrics at a Glance
              </h2>
              <p class="text-white/80 text-base md:text-lg mb-8">
                Explore electricity generation by type, cross-zone flows, carbon and water footprints — all in one clear, interactive interface.
              </p>
              <a
                href="https://dashboard.wattnet.eu"
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 px-6 py-3 bg-primary-600 hover:bg-primary-700 text-white font-semibold rounded-xl shadow-lg hover:shadow-[0_0_10px_rgba(58,120,224,0.3)] active:shadow-[0_0_6px_rgba(58,120,224,0.5)] active:scale-[0.98] transition-all duration-300 focus:outline-none focus:ring-2 focus:ring-primary-500 focus:ring-offset-2"
              >
                Discover the dashboard
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                </svg>
              </a>
            </div>
          </div>
        </div>

      </div>
    </section>

    <!-- Status strip -->
    <section class="py-10 bg-gray-50 dark:bg-gray-900/40 border-y border-gray-200/60 dark:border-white/10 relative overflow-hidden">
      <div class="container-custom slide-up">
        <div class="flex flex-wrap items-center justify-between gap-4">
          <div class="flex items-center gap-5">
            <span class="relative flex h-2.5 w-2.5 shrink-0">
              <span class="animate-status-pulse absolute inline-flex h-full w-full rounded-full bg-accent-400"></span>
              <span class="animate-status-glow absolute inline-flex h-full w-full rounded-full bg-accent-500 blur-[3px]"></span>
              <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-accent-500"></span>
            </span>
            <p class="text-base text-gray-600 dark:text-gray-300">
              <span class="font-semibold text-gray-900 dark:text-white">Uptime & incidents:</span> track the real-time status of the dashboard and API.
            </p>
          </div>
          <a
            href="https://status.wattnet.eu"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 font-semibold text-base text-primary-600 dark:text-primary-400 hover:underline underline-offset-2 shrink-0"
          >
            View status page
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
          </a>
        </div>
      </div>
    </section>

    <!-- API Section -->
    <section class="section bg-gray-100/10 dark:bg-gray-900/10 relative overflow-hidden">
      <div class="container-custom slide-up">
        <div class="grid md:[grid-template-columns:45fr_55fr] gap-12 items-center">
          <div class="px-4 sm:px-0">
            <span class="inline-block px-4 py-1 rounded-full bg-secondary-100 dark:bg-secondary-900 text-secondary-600 dark:text-secondary-300 font-medium text-sm mb-4">
              Developer API
            </span>
            <h2 class="text-3xl font-bold mb-6 bg-gradient-to-r from-gray-900 via-primary-700 to-primary-500 dark:from-white dark:via-primary-200 dark:to-primary-400 bg-clip-text text-transparent">Build Custom Integrations</h2>
            <p class="text-gray-600 dark:text-gray-300 mb-6 text-justify">
              Our API allows seamless integration of <strong>Wattnet</strong> into your workflow. Create dashboards, analyze footprints, and extend functionality with ease.
            </p>
            <div class="space-y-4 mb-8">
              <div class="flex items-start">
                <svg class="w-5 h-5 text-green-500 mt-1 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                </svg>
                <p class="text-gray-600 dark:text-gray-300">RESTful API with comprehensive endpoints</p>
              </div>
              <div class="flex items-start">
                <svg class="w-5 h-5 text-green-500 mt-1 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                </svg>
                <p class="text-gray-600 dark:text-gray-300">Complete OpenAPI Specification (OAS 3.1)</p>
              </div>
              <div class="flex items-start">
                <svg class="w-5 h-5 text-green-500 mt-1 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                </svg>
                <p class="text-gray-600 dark:text-gray-300">Secure authentication with OAuth 2.0</p>
              </div>
            </div>
            <div class="flex flex-col sm:flex-row gap-4">
              <a href="https://api.wattnet.eu/docs" target="_blank" class="btn-primary">API Documentation</a>
              <a href="https://api.wattnet.eu/token-request" target="_blank" class="btn-secondary">Developer Portal</a>
            </div>
          </div>

          <!-- Terminal mockup -->
          <div class="rounded-xl overflow-hidden shadow-2xl border border-gray-200/60 dark:border-white/10 flex flex-col">
            <!-- Browser chrome -->
            <div class="flex items-center gap-3 px-4 py-3 bg-white/70 dark:bg-gray-900/60 backdrop-blur-md border-b border-gray-200/60 dark:border-white/10 shrink-0">
              <div class="flex gap-1.5 shrink-0">
                <span class="w-3 h-3 rounded-full bg-red-400"></span>
                <span class="w-3 h-3 rounded-full bg-yellow-400"></span>
                <span class="w-3 h-3 rounded-full bg-green-400"></span>
              </div>
              <div class="flex-1 bg-white/80 dark:bg-gray-800/60 backdrop-blur-sm rounded-full h-6 flex items-center px-3 text-xs text-gray-500 dark:text-gray-300 border border-gray-200/50 dark:border-white/10 font-mono truncate">
                https://api.wattnet.eu/docs
              </div>
              <a
                href="https://api.wattnet.eu/docs"
                target="_blank"
                rel="noopener noreferrer"
                class="shrink-0 text-gray-500 dark:text-gray-400 hover:text-gray-700 dark:hover:text-white transition-colors"
                aria-label="Open API docs in new tab"
              >
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                </svg>
              </a>
            </div>
            <!-- Terminal body -->
            <div class="bg-gray-100/80 dark:bg-gray-800/40 backdrop-blur-md p-5 font-mono text-sm overflow-x-auto">
              <!-- Prompt line -->
              <div class="flex items-start gap-2 mb-3">
                <span class="text-accent-600 dark:text-accent-400 shrink-0">$</span>
                <pre class="text-gray-700 dark:text-gray-300 whitespace-pre-wrap break-all">curl -X GET "https://api.wattnet.eu/v1/footprints?lat=43.4717&lon=-3.8024&footprint_type=carbon&start=2025-09-01T01%3A02%3A03Z&end=2025-09-01T04%3A05%3A06Z&aggregate=true" \
  -H <span class="text-yellow-600 dark:text-yellow-300">"Authorization: Bearer YOUR_API_KEY"</span> \
  -H <span class="text-yellow-600 dark:text-yellow-300">"Content-Type: application/json"</span></pre>
              </div>
              <!-- Divider -->
              <div class="border-t border-gray-300 dark:border-gray-800 my-3"></div>
              <!-- Response -->
              <div class="text-xs text-gray-500 dark:text-gray-500 mb-2">// 200 OK · application/json</div>
              <pre class="text-sm leading-relaxed"><span class="text-gray-500 dark:text-gray-500">[</span>
  <span class="text-gray-500 dark:text-gray-500">{`{`}</span>
    <span class="text-blue-600 dark:text-blue-300">"footprint_type"</span><span class="text-gray-500">,</span> <span class="text-green-600 dark:text-green-300">"carbon"</span><span class="text-gray-500">,</span>
    <span class="text-blue-600 dark:text-blue-300">"scope"</span><span class="text-gray-500">:</span>          <span class="text-green-600 dark:text-green-300">"life-cycle"</span><span class="text-gray-500">,</span>
    <span class="text-blue-600 dark:text-blue-300">"zone"</span><span class="text-gray-500">:</span>           <span class="text-green-600 dark:text-green-300">"ES"</span><span class="text-gray-500">,</span>
    <span class="text-blue-600 dark:text-blue-300">"unit"</span><span class="text-gray-500">:</span>           <span class="text-green-600 dark:text-green-300">"gCO2/kWh"</span><span class="text-gray-500">,</span>
    <span class="text-blue-600 dark:text-blue-300">"value"</span><span class="text-gray-500">:</span>          <span class="text-orange-600 dark:text-orange-300">91.963</span><span class="text-gray-500">,</span>
    <span class="text-blue-600 dark:text-blue-300">"valid"</span><span class="text-gray-500">:</span>          <span class="text-purple-600 dark:text-purple-300">true</span><span class="text-gray-500">,</span>
    <span class="text-blue-600 dark:text-blue-300">"start"</span><span class="text-gray-500">:</span>          <span class="text-green-600 dark:text-green-300">"2025-09-01T01:02:03Z"</span><span class="text-gray-500">,</span>
    <span class="text-blue-600 dark:text-blue-300">"end"</span><span class="text-gray-500">:</span>            <span class="text-green-600 dark:text-green-300">"2025-09-01T04:05:06Z"</span>
  <span class="text-gray-500 dark:text-gray-500">{`}`}</span>
<span class="text-gray-500 dark:text-gray-500">]</span></pre>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Python Client Section -->
    <section id="python-client" class="section bg-white/70 dark:bg-gray-800/50 relative overflow-hidden">
      <div class="container-custom slide-up">
        <div class="grid md:[grid-template-columns:60fr_40fr] gap-12 lg:gap-16 items-center">

          <!-- IDE mockup -->
          <div x-data="{ tab: 'quickstart', file: 'quickstart.py', auto: !window.matchMedia('(prefers-reduced-motion: reduce)').matches, paused: false, order: [['quickstart', 'quickstart.py'], ['score', 'by_location.py'], ['async', 'async_example.py']], next() { const i = this.order.findIndex(t => t[0] === this.tab); [this.tab, this.file] = this.order[(i + 1) % this.order.length] } }" x-init="setInterval(() => { if (auto && !paused && !document.hidden) next() }, 6000)" @mouseenter="paused = true" @mouseleave="paused = false" @focusin="paused = true" @focusout="paused = false" class="rounded-xl overflow-hidden shadow-2xl border border-gray-200/60 dark:border-white/10 flex flex-col order-2 md:order-1 bg-gray-100/80 dark:bg-gray-800/40 backdrop-blur-md font-mono text-[13px]">
            <!-- Title bar -->
            <div class="flex items-center gap-3 px-4 py-2.5 bg-white/70 dark:bg-gray-900/60 backdrop-blur-md border-b border-gray-200/60 dark:border-white/10 shrink-0">
              <div class="flex gap-1.5 shrink-0">
                <span class="w-3 h-3 rounded-full bg-red-400"></span>
                <span class="w-3 h-3 rounded-full bg-yellow-400"></span>
                <span class="w-3 h-3 rounded-full bg-green-400"></span>
              </div>
              <span class="flex-1 text-center text-xs text-gray-600 dark:text-gray-400 truncate"><span x-text="file">quickstart.py</span> - wattnet-client-demo</span>
              <span class="w-12 shrink-0"></span>
            </div>
            <div class="flex">
              <!-- Activity bar -->
              <div class="hidden sm:flex flex-col items-center gap-4 py-3 px-2.5 bg-white/40 dark:bg-gray-900/40 text-gray-500 dark:text-gray-400 shrink-0" aria-hidden="true">
                <svg class="w-5 h-5 text-gray-800 dark:text-white" fill="none" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M7 3h7l5 5v13H7zM14 3v5h5"/></svg>
                <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24"><circle cx="11" cy="11" r="6"/><path stroke-linecap="round" d="M20 20l-4.5-4.5"/></svg>
                <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24"><circle cx="6" cy="6" r="2"/><circle cx="6" cy="18" r="2"/><circle cx="18" cy="8" r="2"/><path d="M6 8v8M18 10c0 4-8 2-12 6"/></svg>
                <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M10 19.655A6 6 0 0 1 6 14v-3a4 4 0 0 1 4-4h4a4 4 0 0 1 4 3.97"/><path d="M14 15.003a1 1 0 0 1 1.517-.859l4.997 2.997a1 1 0 0 1 0 1.718l-4.997 2.997a1 1 0 0 1-1.517-.86z"/><path d="M14.12 3.88 16 2"/><path d="M21 5a4 4 0 0 1-3.55 3.97"/><path d="M3 21a4 4 0 0 1 3.81-4"/><path d="M3 5a4 4 0 0 0 3.55 3.97"/><path d="M6 13H2"/><path d="m8 2 1.88 1.88"/><path d="M9 7.13V6a3 3 0 1 1 6 0v1.13"/></svg>
                <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><rect x="3" y="12" width="8" height="8" rx="1"/><rect x="13" y="12" width="8" height="8" rx="1"/><rect x="3" y="4" width="8" height="6" rx="1"/><path d="M17 3v6M14 6h6"/></svg>
                <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><rect x="6" y="3" width="12" height="18" rx="2"/><path d="M9 7h6M9 11h6M9 15h3"/></svg>
                <div class="mt-auto flex flex-col items-center gap-4">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4.4 3.6-8 8-8s8 3.6 8 8"/></svg>
                <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z"/><circle cx="12" cy="12" r="3"/></svg>
                </div>
              </div>
              <div class="flex-1 min-w-0 flex flex-col">
                <!-- Tabs -->
                <div class="flex bg-white/40 dark:bg-gray-900/40 text-xs shrink-0 overflow-x-auto" role="tablist" aria-label="Python client examples">
                  <button type="button" role="tab" @click="tab = 'quickstart'; file = 'quickstart.py'; auto = false" :aria-selected="tab === 'quickstart'" class="flex items-center gap-2 px-4 py-2 whitespace-nowrap border-t-2 transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-primary-500" :class="tab === 'quickstart' ? 'bg-gray-100/60 dark:bg-white/5 text-gray-800 dark:text-gray-200 border-primary-500' : 'text-gray-500 hover:text-gray-800 dark:hover:text-gray-200 border-transparent'">
                    <span class="text-yellow-600 dark:text-yellow-400">py</span> quickstart.py
                  </button>
                  <button type="button" role="tab" @click="tab = 'score'; file = 'by_location.py'; auto = false" :aria-selected="tab === 'score'" class="flex items-center gap-2 px-4 py-2 whitespace-nowrap border-t-2 transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-primary-500" :class="tab === 'score' ? 'bg-gray-100/60 dark:bg-white/5 text-gray-800 dark:text-gray-200 border-primary-500' : 'text-gray-500 hover:text-gray-800 dark:hover:text-gray-200 border-transparent'">
                    <span class="text-yellow-600 dark:text-yellow-400">py</span> by_location.py
                  </button>
                  <button type="button" role="tab" @click="tab = 'async'; file = 'async_example.py'; auto = false" :aria-selected="tab === 'async'" class="flex items-center gap-2 px-4 py-2 whitespace-nowrap border-t-2 transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-primary-500" :class="tab === 'async' ? 'bg-gray-100/60 dark:bg-white/5 text-gray-800 dark:text-gray-200 border-primary-500' : 'text-gray-500 hover:text-gray-800 dark:hover:text-gray-200 border-transparent'">
                    <span class="text-yellow-600 dark:text-yellow-400">py</span> async_example.py
                  </button>
                </div>
                <div class="grid">
                <div class="col-start-1 row-start-1" :class="{ 'invisible': tab !== 'quickstart' }" :aria-hidden="tab !== 'quickstart'" role="tabpanel">
                  <!-- Editor -->
                  <div class="flex overflow-x-auto py-4 leading-6 h-[344px]">
                    <div class="select-none text-right text-gray-400 dark:text-gray-600 pl-4 pr-4 shrink-0" aria-hidden="true">1<br>2<br>3<br>4<br>5<br>6<br>7<br>8<br>9<br>10<br>11<br>12<br>13</div>
                    <pre class="text-gray-800 dark:text-[#d4d4d4] pr-4"><span class="text-purple-600 dark:text-[#c586c0]">from</span> wattnet.client <span class="text-purple-600 dark:text-[#c586c0]">import</span> <span class="text-teal-700 dark:text-[#4ec9b0]">WattnetClient</span>

client = <span class="text-teal-700 dark:text-[#4ec9b0]">WattnetClient</span>(
    email=<span class="text-orange-700 dark:text-[#ce9178]">&quot;you@example.com&quot;</span>,
    password=<span class="text-orange-700 dark:text-[#ce9178]">&quot;&lt;your-password&gt;&quot;</span>,
)

<span class="text-green-700 dark:text-[#6a9955]"># Every call returns a pandas DataFrame</span>
df = client.<span class="text-yellow-700 dark:text-[#dcdcaa]">get_footprints</span>(zone=<span class="text-orange-700 dark:text-[#ce9178]">&quot;ES&quot;</span>, footprint_type=<span class="text-orange-700 dark:text-[#ce9178]">&quot;carbon&quot;</span>)
<span class="text-green-700 dark:text-[#6a9955]"># Solar generation, same zone</span>
solar = client.<span class="text-yellow-700 dark:text-[#dcdcaa]">get_generation</span>(zone=<span class="text-orange-700 dark:text-[#ce9178]">&quot;ES&quot;</span>, production_type=<span class="text-orange-700 dark:text-[#ce9178]">&quot;solar&quot;</span>)

<span class="text-yellow-700 dark:text-[#dcdcaa]">print</span>(df.<span class="text-yellow-700 dark:text-[#dcdcaa]">tail</span>(<span class="text-green-800 dark:text-[#b5cea8]">3</span>))</pre>
                  </div>
                  <!-- Terminal panel -->
