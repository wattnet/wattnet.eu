---
import Layout from '../layouts/Layout.astro';
import Header from '../components/common/Header.astro';
import Footer from '../components/common/Footer.astro';
import HeroSection from '../components/common/HeroSection.astro';
import CallToAction from '../components/common/CallToAction.astro';
import PythonClientSection from '../components/services/PythonClientSection.astro';
import HomeAssistantSection from '../components/services/HomeAssistantSection.astro';
import DashboardSection from '../components/services/DashboardSection.astro';
import StatusStrip from '../components/services/StatusStrip.astro';
import ApiSection from '../components/services/ApiSection.astro';
import DatasetsSection from '../components/services/DatasetsSection.astro';
---

<Layout
  title="Data Services | Wattnet"
  description="Tools to track and analyze electricity generation, cross-border flows, and carbon and water footprints across Europe, from interactive exploration to automation."
>
  <Header />
  <main>
    <HeroSection
      title="Next-Level Services"
      highlightText="Services"
      description="Track electricity generation, cross-border flows, and the carbon and water footprints of European electricity, with tools built for every workflow, from interactive exploration to automation."
    />

    <!-- Dashboard Preview Section -->
    <DashboardSection />

    <!-- Status strip -->
    <StatusStrip />

    <!-- API Section -->
    <ApiSection />

    <!-- Python Client Section -->
    <PythonClientSection />

    <!-- Home Assistant Section -->
    <HomeAssistantSection />

    <!-- Curated Datasets Section -->
    <DatasetsSection />
    <CallToAction
      title="Ready to explore all energy insights?"
      description="Everything you need to track electricity generation, cross-zone flows, and environmental footprints."
    />
  </main>
  <Footer />
</Layout>
