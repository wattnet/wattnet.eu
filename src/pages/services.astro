---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import HeroSection from '../components/HeroSection.astro';
import { Image } from "astro:assets";
import DashboardPreview from '../assets/dashboard-preview.png';
import CallToAction from '../components/CallToAction.astro';
---

<Layout
  title="Data Services | Wattnet"
  description="Dashboard, API, and curated datasets to analyze electricity generation, exchanges, and environmental footprints."
>
  <Header />
  <main>
    <HeroSection
      title="Next-Level Services"
      highlightText="Services"
      description="Track, visualize, and analyze electricity generation, cross-border exchanges, and carbon & water footprints with our dashboard, API, and curated datasets."
    />

    <!-- Dashboard Preview Section -->
    <section class="section bg-white/70 dark:bg-gray-800/50 relative overflow-hidden">
      <div class="container-custom slide-up">

        <!-- Browser mockup -->
        <div class="rounded-xl shadow-2xl overflow-hidden border border-gray-200/60 dark:border-white/10 mx-4 sm:mx-auto">

          <!-- Browser chrome (unified style) -->
          <div class="flex items-center gap-3 px-4 py-3 bg-white/70 dark:bg-gray-900/60 backdrop-blur-md border-b border-gray-200/60 dark:border-white/10 shrink-0">
            <div class="flex gap-1.5 shrink-0">
              <span class="w-3 h-3 rounded-full bg-red-400"></span>
              <span class="w-3 h-3 rounded-full bg-yellow-400"></span>
              <span class="w-3 h-3 rounded-full bg-green-400"></span>
            </div>
            <div class="flex-1 bg-white/80 dark:bg-gray-800/60 backdrop-blur-sm rounded-full h-6 flex items-center px-3 text-xs text-gray-500 dark:text-gray-300 border border-gray-200/50 dark:border-white/10 font-mono truncate">
              https://dashboard.wattnet.eu
            </div>
            <a
              href="https://dashboard.wattnet.eu"
              target="_blank"
              rel="noopener noreferrer"
              class="shrink-0 text-gray-500 dark:text-gray-400 hover:text-gray-700 dark:hover:text-white transition-colors"
              aria-label="Open dashboard in new tab"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
            </a>
          </div>

          <!-- Content area -->
          <div class="relative h-[480px] flex items-center justify-center overflow-hidden">

            <!-- Blurred background image -->
            <Image
              src={DashboardPreview}
              alt="Preview of the Wattnet dashboard interface"
              class="absolute inset-0 w-full h-full object-cover scale-105 blur-md opacity-70"
              width={1920}
              height={1080}
              quality={80}
              priority
            />

            <!-- Gradient overlay for readability -->
            <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-black/25 to-black/10" />

            <!-- Text overlay -->
            <div class="relative z-10 text-center px-6 max-w-2xl mx-auto">
              <div class="inline-flex items-center gap-2 mb-6 px-4 py-1.5 rounded-full bg-white/15 backdrop-blur-sm border border-white/25 text-white text-sm font-medium">
                <span class="w-2 h-2 rounded-full bg-accent-400 animate-pulse shrink-0"></span>
                Web Dashboard Available Now
              </div>
              <h2 class="text-3xl md:text-4xl font-bold text-white mb-4">
                Visualize All Metrics at a Glance
              </h2>
              <p class="text-white/80 text-base md:text-lg mb-8">
                Explore electricity generation by type, cross-zone flows, carbon and water footprints — all in one clear, interactive interface.
              </p>
              <a
                href="https://dashboard.wattnet.eu"
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 px-6 py-3 bg-primary-600 hover:bg-primary-700 text-white font-semibold rounded-xl shadow-lg hover:shadow-[0_0_10px_rgba(58,120,224,0.3)] active:shadow-[0_0_6px_rgba(58,120,224,0.5)] active:scale-[0.98] transition-all duration-300 focus:outline-none focus:ring-2 focus:ring-primary-500 focus:ring-offset-2"
              >
                Discover the dashboard
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                </svg>
              </a>
            </div>
          </div>
        </div>

      </div>
    </section>

    <!-- Status strip -->
    <section class="py-10 bg-gray-50 dark:bg-gray-900/40 border-y border-gray-200/60 dark:border-white/10 relative overflow-hidden">
      <div class="container-custom slide-up">
        <div class="flex flex-wrap items-center justify-between gap-4">
          <div class="flex items-center gap-5">
            <span class="relative flex h-2.5 w-2.5 shrink-0">
              <span class="animate-status-pulse absolute inline-flex h-full w-full rounded-full bg-accent-400"></span>
              <span class="animate-status-glow absolute inline-flex h-full w-full rounded-full bg-accent-500 blur-[3px]"></span>
              <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-accent-500"></span>
            </span>
            <p class="text-base text-gray-600 dark:text-gray-300">
              <span class="font-semibold text-gray-900 dark:text-white">Uptime & incidents:</span> track the real-time status of the dashboard and API.
            </p>
          </div>
          <a
            href="https://status.wattnet.eu"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 font-semibold text-base text-primary-600 dark:text-primary-400 hover:underline underline-offset-2 shrink-0"
          >
            View status page
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
          </a>
        </div>
      </div>
    </section>

    <!-- API Section -->
    <section class="section bg-gray-100/10 dark:bg-gray-900/10 relative overflow-hidden">
      <div class="container-custom slide-up">
        <div class="grid md:[grid-template-columns:45fr_55fr] gap-12 items-center">
          <div class="px-4 sm:px-0">
            <span class="inline-block px-4 py-1 rounded-full bg-secondary-100 dark:bg-secondary-900 text-secondary-600 dark:text-secondary-300 font-medium text-sm mb-4">
              Developer API
            </span>
            <h2 class="text-3xl font-bold mb-6 bg-gradient-to-r from-gray-900 via-primary-700 to-primary-500 dark:from-white dark:via-primary-200 dark:to-primary-400 bg-clip-text text-transparent">Build Custom Integrations</h2>
            <p class="text-gray-600 dark:text-gray-300 mb-6 text-justify">
              Our API allows seamless integration of <strong>Wattnet</strong> into your workflow. Create dashboards, analyze footprints, and extend functionality with ease.
            </p>
            <div class="space-y-4 mb-8">
              <div class="flex items-start">
                <svg class="w-5 h-5 text-green-500 mt-1 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                </svg>
                <p class="text-gray-600 dark:text-gray-300">RESTful API with comprehensive endpoints</p>
              </div>
              <div class="flex items-start">
                <svg class="w-5 h-5 text-green-500 mt-1 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                </svg>
                <p class="text-gray-600 dark:text-gray-300">Complete OpenAPI Specification (OAS 3.1)</p>
              </div>
              <div class="flex items-start">
                <svg class="w-5 h-5 text-green-500 mt-1 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                </svg>
                <p class="text-gray-600 dark:text-gray-300">Secure authentication with OAuth 2.0</p>
              </div>
            </div>
            <div class="flex flex-col sm:flex-row gap-4">
              <a href="https://api.wattnet.eu/docs" target="_blank" class="btn-primary">API Documentation</a>
              <a href="https://api.wattnet.eu/token-request" target="_blank" class="btn-secondary">Developer Portal</a>
            </div>
          </div>

          <!-- Terminal mockup -->
          <div class="rounded-xl overflow-hidden shadow-2xl border border-gray-200/60 dark:border-white/10 flex flex-col">
            <!-- Browser chrome -->
            <div class="flex items-center gap-3 px-4 py-3 bg-white/70 dark:bg-gray-900/60 backdrop-blur-md border-b border-gray-200/60 dark:border-white/10 shrink-0">
              <div class="flex gap-1.5 shrink-0">
                <span class="w-3 h-3 rounded-full bg-red-400"></span>
                <span class="w-3 h-3 rounded-full bg-yellow-400"></span>
                <span class="w-3 h-3 rounded-full bg-green-400"></span>
              </div>
              <div class="flex-1 bg-white/80 dark:bg-gray-800/60 backdrop-blur-sm rounded-full h-6 flex items-center px-3 text-xs text-gray-500 dark:text-gray-300 border border-gray-200/50 dark:border-white/10 font-mono truncate">
                https://api.wattnet.eu/docs
              </div>
              <a
                href="https://api.wattnet.eu/docs"
                target="_blank"
                rel="noopener noreferrer"
                class="shrink-0 text-gray-500 dark:text-gray-400 hover:text-gray-700 dark:hover:text-white transition-colors"
                aria-label="Open API docs in new tab"
              >
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                </svg>
              </a>
            </div>
            <!-- Terminal body -->
            <div class="bg-gray-100/80 dark:bg-gray-800/40 backdrop-blur-md p-5 font-mono text-sm overflow-x-auto">
              <!-- Prompt line -->
              <div class="flex items-start gap-2 mb-3">
                <span class="text-accent-600 dark:text-accent-400 shrink-0">$</span>
                <pre class="text-gray-700 dark:text-gray-300 whitespace-pre-wrap break-all">curl -X GET "https://api.wattnet.eu/v1/footprints?lat=43.4717&lon=-3.8024&footprint_type=carbon&start=2025-09-01T01%3A02%3A03Z&end=2025-09-01T04%3A05%3A06Z&aggregate=true" \
  -H <span class="text-yellow-600 dark:text-yellow-300">"Authorization: Bearer YOUR_API_KEY"</span> \
  -H <span class="text-yellow-600 dark:text-yellow-300">"Content-Type: application/json"</span></pre>
              </div>
              <!-- Divider -->
              <div class="border-t border-gray-300 dark:border-gray-800 my-3"></div>
              <!-- Response -->
              <div class="text-xs text-gray-500 dark:text-gray-500 mb-2">// 200 OK · application/json</div>
              <pre class="text-sm leading-relaxed"><span class="text-gray-500 dark:text-gray-500">[</span>
  <span class="text-gray-500 dark:text-gray-500">{`{`}</span>
    <span class="text-blue-600 dark:text-blue-300">"footprint_type"</span><span class="text-gray-500">,</span> <span class="text-green-600 dark:text-green-300">"carbon"</span><span class="text-gray-500">,</span>
    <span class="text-blue-600 dark:text-blue-300">"scope"</span><span class="text-gray-500">:</span>          <span class="text-green-600 dark:text-green-300">"life-cycle"</span><span class="text-gray-500">,</span>
    <span class="text-blue-600 dark:text-blue-300">"zone"</span><span class="text-gray-500">:</span>           <span class="text-green-600 dark:text-green-300">"ES"</span><span class="text-gray-500">,</span>
    <span class="text-blue-600 dark:text-blue-300">"unit"</span><span class="text-gray-500">:</span>           <span class="text-green-600 dark:text-green-300">"gCO2/kWh"</span><span class="text-gray-500">,</span>
    <span class="text-blue-600 dark:text-blue-300">"value"</span><span class="text-gray-500">:</span>          <span class="text-orange-600 dark:text-orange-300">91.963</span><span class="text-gray-500">,</span>
    <span class="text-blue-600 dark:text-blue-300">"valid"</span><span class="text-gray-500">:</span>          <span class="text-purple-600 dark:text-purple-300">true</span><span class="text-gray-500">,</span>
    <span class="text-blue-600 dark:text-blue-300">"start"</span><span class="text-gray-500">:</span>          <span class="text-green-600 dark:text-green-300">"2025-09-01T01:02:03Z"</span><span class="text-gray-500">,</span>
    <span class="text-blue-600 dark:text-blue-300">"end"</span><span class="text-gray-500">:</span>            <span class="text-green-600 dark:text-green-300">"2025-09-01T04:05:06Z"</span>
  <span class="text-gray-500 dark:text-gray-500">{`}`}</span>
<span class="text-gray-500 dark:text-gray-500">]</span></pre>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Curated Datasets Section -->
    <section id="datasets" class="section bg-white/70 dark:bg-gray-800/50">
      <div class="container-custom slide-up">
        <div class="text-center max-w-6xl mx-auto mb-16">
          <span class="inline-block px-4 py-1 rounded-full bg-primary-100 dark:bg-primary-900 text-primary-600 dark:text-primary-300 font-medium text-sm mb-6">
            Curated Datasets
          </span>
          <h2 class="mb-6 bg-gradient-to-r from-gray-900 via-primary-700 to-primary-500 dark:from-white dark:via-primary-200 dark:to-primary-400 bg-clip-text text-transparent">Ready-to-use, High-Quality Data Collections</h2>
          <p class="text-gray-600 dark:text-gray-300">
                  Explore curated datasets covering energy generation, cross-border exchanges, and environmental footprints for research and analysis.
          </p>
        </div>


        <div class="grid md:grid-cols-2 lg:grid-cols-3 divide-y divide-secondary-200/60 dark:divide-secondary-800/60 border-y border-secondary-200/60 dark:border-secondary-800/60 bg-gray-100 dark:bg-gray-900/40">
            <!-- Electricity Generation -->
            <div class="relative p-6 sm:p-8">
              <span class="absolute top-6 right-6 sm:top-8 sm:right-8 text-xs font-mono font-medium text-gray-300 dark:text-gray-600 select-none">01</span>
              <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-yellow-100 to-yellow-200 dark:from-yellow-900/50 dark:to-yellow-800/30 flex items-center justify-center mb-5">
                <svg class="w-6 h-6 text-yellow-600 dark:text-yellow-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
                </svg>
              </div>
              <h3 class="text-xl font-semibold mb-3 text-gray-900 dark:text-white">Electricity Generation</h3>
              <p class="text-gray-600 dark:text-gray-300">
                Detailed 15-minute resolution insights into electricity production by generation type across Europe.
              </p>
            </div>

            <!-- Cross-Border Exchanges -->
            <div class="relative p-6 sm:p-8">
              <span class="absolute top-6 right-6 sm:top-8 sm:right-8 text-xs font-mono font-medium text-gray-300 dark:text-gray-600 select-none">02</span>
              <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-blue-100 to-blue-200 dark:from-blue-900/50 dark:to-blue-800/30 flex items-center justify-center mb-5">
                <svg class="w-6 h-6 text-blue-600 dark:text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 7h14m0 0l-3-3m3 3l-3 3" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 17H5m0 0l3-3m-3 3l3 3" />
                </svg>
              </div>
              <h3 class="text-xl font-semibold mb-3 text-gray-900 dark:text-white">Cross-Border Exchanges</h3>
              <p class="text-gray-600 dark:text-gray-300">
                Track imports and exports of electricity between European countries and regions in real time.
              </p>
            </div>

            <!-- Carbon & Water Footprints -->
            <div class="relative p-6 sm:p-8">
              <span class="absolute top-6 right-6 sm:top-8 sm:right-8 text-xs font-mono font-medium text-gray-300 dark:text-gray-600 select-none">03</span>
              <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-green-100 to-green-200 dark:from-green-900/50 dark:to-green-800/30 flex items-center justify-center mb-5">
                <svg class="w-6 h-6 text-green-600 dark:text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 21V12" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 12C7 12 4 8 4 5c0 0 4 1 8 5z" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 12c5 0 7-4 7-6 0 0-3 1-7 6z" />
                </svg>
              </div>
              <h3 class="text-xl font-semibold mb-3 text-gray-900 dark:text-white">Carbon & Water Footprints</h3>
              <p class="text-gray-600 dark:text-gray-300">
                Monitor carbon emissions and water consumption for electricity, helping track environmental impact.
              </p>
            </div>
          </div>
          
        <div class="flex justify-end mt-8">
          <a
            href="/resources#datasets"
            class="inline-flex items-center gap-2 px-6 py-3 bg-primary-600 dark:bg-primary-500 text-white font-semibold rounded-xl shadow-md hover:bg-primary-700 dark:hover:bg-primary-600 hover:shadow-[0_0_10px_rgba(58,120,224,0.3)] active:shadow-[0_0_6px_rgba(58,120,224,0.5)] active:scale-[0.98] transition-all duration-300"
          >
            Explore All Datasets
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
        </div>
      </div>
    </section>
    <CallToAction
      title="Ready to explore all energy insights?"
      description="Everything you need to track electricity generation, cross-zone flows, and environmental footprints."
    />
  </main>
  <Footer />
</Layout>
