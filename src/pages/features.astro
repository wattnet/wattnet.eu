---
import Layout from '../layouts/Layout.astro';
import Header from '../components/common/Header.astro';
import Footer from '../components/common/Footer.astro';
import HeroSection from '../components/common/HeroSection.astro';
import CallToAction from '../components/common/CallToAction.astro';

import FeatureList from '../components/features/FeatureList.astro';
---

<Layout
  title="Features | Wattnet"
  description="Explore real-time electricity insights, high-resolution data, and footprint metrics to understand Europe's energy impact."
>
  <Header />
  <main>
    <!-- Hero Section -->
    <HeroSection
      title="Cutting-Edge Features"
      highlightText="Features"
      description="Explore the innovative features of Wattnet that provide deep insights into electricity consumption and its environmental impact."
    />

    <FeatureList />
    <CallToAction
      title="Ready to Explore Europe's Electricity Footprint?"
      description="Access high-resolution electricity data, carbon and water footprints, and interactive dashboards – all ready to use for your research or projects."
    />
  </main>
  <Footer />
</Layout>
