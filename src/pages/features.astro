---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import HeroSection from '../components/HeroSection.astro';

const featuresComplete = [
  {
    title: "Real-Time Insights",
    description: "Live updates on electricity generation, flows, and environmental footprint across all European zones.",
    icon: "M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z",
    color: "primary"
  },
  {
    title: "Historical Data",
    description: "Explore past electricity patterns and footprint evolution to analyze trends across regions.",
    icon: "M3 5h18M3 12h18M3 19h18",
    color: "accent"
  },
  {
    title: "Forecast & Planning",
    description: "Short-term forecasts of carbon and water footprints to plan energy usage efficiently.",
    icon: "M3 17l6-6 4 4 8-8M21 21H3V3",
    color: "primary"
  },
  {
    title: "Transparency & Reliability",
    description: "Data is validated and processed consistently, ensuring accuracy, comparability, and reliable insights.",
    icon: "M5 13l4 4L19 7",
    color: "accent"
  },
  {
    title: "Cross-Zone Comparisons",
    description: "Compare energy mixes, flows, and footprints between multiple European zones quickly and easily.",
    icon: "M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5a2.5 2.5 0 110-5 2.5 2.5 0 010 5z",
    color: "primary"
  },
  {
    title: "Research & Policy Support",
    description: "Actionable insights for scientists, businesses, and policymakers to drive sustainable decisions.",
    icon: "M21 21l-4.35-4.35M11 19a8 8 0 100-16 8 8 0 000 16z",
    color: "accent"
  },
  {
    title: "High-Resolution Data",
    description: "60 European zones monitored every 15 minutes, delivering detailed, granular, and actionable insights.",
    icon: "M6 2h12M6 22h12M6 2v6a6 6 0 006 6 6 6 0 006-6V2M6 22v-6a6 6 0 006-6 6 6 0 006 6v6",
    color: "primary"
  },
  {
    title: "Generation by Production Type",
    description: "Detailed breakdown of electricity generation by production type: solar, wind, biomass, nuclear, gas, and more.",
    icon: "M13 10V3L4 14h7v7l9-11h-7z",
    color: "accent"
  },
  {
    title: "Cross-Border Flows",
    description: "Track electricity imports and exports, including flow share distribution between all zones.",
    icon: "M5 7h14m0 0l-3-3m3 3l-3 3M19 17H5m0 0l3-3m-3 3l3 3",
    color: "primary"
  },
  {
    title: "Footprint Metrics",
    description: "Carbon and water footprints for each zone, locally and globally, including operation and lifecycle scopes.",
    icon: "M12 21V12M12 12C7 12 4 8 4 5c0 0 4 1 8 4c4-3 8-4 8-4c0 4-4 8-8 8z",
    color: "accent"
  },
  {
    title: "Emission Factors",
    description: "Current emission and impact factors per generation type for precise environmental analysis.",
    icon: "M3 3v18h20M9 14v4M15 10v8M21 6v12",
    color: "primary"
  },
  {
    title: "Zone Mix & Flow Share",
    description: "Analyze each zone's energy mix and flow share to see contributions to other zones’ footprints.",
    icon: "M12 2C6 2 2 6 2 12s4 10 10 10 10-4 10-10-4-10-10z",
    color: "accent"
  }
];
---

<Layout title="Features - wattnet.eu" description="Discover the cutting-edge features of wattnet that provide deep insights into electricity consumption and its environmental impact. Explore interactive demos and see how our technology can benefit your energy research and sustainability efforts.">
  <Header />
  <main>
    <!-- Hero Section -->
      <HeroSection 
      title="Cutting-Edge Features" 
      highlightText="Features"
      description="Explore the innovative features of wattnet that provide deep insights into electricity consumption and its environmental impact."
    />

    <section id="features" class="section bg-gray-50/25 dark:bg-gray-800/50">
      <div class="container-custom">
        <div class="text-center max-w-4xl mx-auto mb-16">
          <span class="inline-block px-4 py-1 rounded-full bg-primary-100 dark:bg-primary-900 text-primary-600 dark:text-primary-300 font-medium text-sm mb-6">
            Key Features
          </span>
          <h2 class="mb-6 text-gray-900 dark:text-white">Comprehensive Features for Electricity Insights</h2>
          <p class="text-gray-600 dark:text-gray-300">
            Discover the full range of capabilities offered by <strong>wattnet</strong>, delivering detailed, high-resolution insights into electricity consumption and its environmental footprint across Europe.
          </p>
        </div>
        
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
          {featuresComplete.map((feature, index) => (
            <div 
              class="card p-6 border border-gray-200 dark:border-gray-700 slide-up" 
              style={`animation-delay: ${index * 100}ms`}
            >
              <div class={`w-12 h-12 rounded-lg bg-${feature.color}-100 dark:bg-${feature.color}-900/30 flex items-center justify-center mb-6`}>
                <svg 
                  class={`w-6 h-6 text-${feature.color}-600 dark:text-${feature.color}-400`} 
                  fill="none" 
                  stroke="currentColor" 
                  viewBox="0 0 24 24" 
                  xmlns="http://www.w3.org/2000/svg"
                >
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={feature.icon}></path>
                </svg>
              </div>
              <h3 class="text-xl font-semibold mb-3 text-gray-900 dark:text-white">{feature.title}</h3>
              <p class="text-gray-600 dark:text-gray-300">{feature.description}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Call to Action -->
    <section class="section bg-linear-to-br from-primary-600 to-primary-800 dark:from-primary-800 dark:to-primary-900 text-white py-12 md:py-16">
      <div class="container-custom slide-up">
        <div class="text-center max-w-3xl mx-auto px-4">
          <h2 class="text-2xl md:text-3xl mb-4 md:mb-6 text-white">Ready to Explore Europe's Electricity Footprint?</h2>
          <p class="text-primary-100 mb-6 md:mb-8">
            Access high-resolution electricity data, carbon and water footprints, and interactive dashboards – all ready to use for your research or projects.
          </p>
          <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <a href="https://dashboard.wattnet.eu" target="_blank" rel="noopener noreferrer" class="btn-accent text-sm md:text-base px-4 py-2 md:px-6 md:py-3 w-full sm:w-auto">
              Get Started Now
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 md:h-5 md:w-5 ml-2" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M10.293 5.293a1 1 0 011.414 0l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414-1.414L12.586 11H5a1 1 0 110-2h7.586l-2.293-2.293a1 1 0 010-1.414z" clip-rule="evenodd" />
              </svg>
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
