---
import Layout from '../layouts/Layout.astro';
import Header from '../components/common/Header.astro';
import Footer from '../components/common/Footer.astro';
import HeroSection from '../components/common/HeroSection.astro';
import Software from '../components/resources/Software.astro';
import Publications from '../components/resources/Publications.astro';
import Datasets from '../components/resources/Datasets.astro';
import CallToAction from '../components/common/CallToAction.astro';
---

<Layout
  title="Resources | Wattnet"
  description="Open datasets, publications, and software to study electricity footprints and energy systems across Europe."
>
  <Header />
  <main>
    <HeroSection
      title="Explore Our Resources"
      highlightText="Resources"
      description="Discover a wealth of open energy datasets, research papers, and tools designed to help you understand and reduce your electricity footprint across Europe."
    />
    <!-- Resources Sections -->
    <Publications />
    <Datasets />
    <Software />
    <CallToAction
      title="Ready to explore all energy insights?"
      description="Everything you need to track electricity generation, cross-zone flows, and environmental footprints."
    />
  </main>
  <Footer />
</Layout>
