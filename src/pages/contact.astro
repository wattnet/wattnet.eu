---
import Layout from '../layouts/Layout.astro';
import Header from '../components/common/Header.astro';
import ContactForm from '../components/contact/ContactForm.astro';
import Team from '../components/common/Team.astro';
import Footer from '../components/common/Footer.astro';
import HeroSection from '../components/common/HeroSection.astro';
---

<Layout
  title="Contact | Wattnet"
  description="Contact for questions about electricity footprint data, services, or partnerships."
>
  <Header />
  <main>
    <HeroSection
      title="Contact Us"
      highlightText="Contact"
      description="We're here to help with any questions you might have about our services."
    />
    <ContactForm />
    <Team />
  </main>
  <Footer />
</Layout>
