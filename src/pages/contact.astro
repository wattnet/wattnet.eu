---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import ContactForm from '../components/ContactForm.astro';
import Team from '../components/Team.astro';
import Footer from '../components/Footer.astro';
import HeroSection from '../components/HeroSection.astro';
---

<Layout
  title="Contact | Wattnet"
  description="Contact for questions about electricity footprint data, services, or partnerships."
>
  <Header />
  <main>
    <HeroSection
      title="Contact Us"
      highlightText='Contact'
      description="We're here to help with any questions you might have about our services."
    />
    <ContactForm />
    <Team />
  </main>
  <Footer />
</Layout>
