---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import ContactSection from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
import HeroSection from '../components/HeroSection.astro';
---

<Layout
  title="Contact | Wattnet"
  description="Contact for questions about electricity footprint data, services, or partnerships."
>
  <Header />
  <main>
    <HeroSection 
      title="Contact Us"
      highlightText='Contact'
      description="We're here to help with any questions you might have about our services."
    />
    <ContactSection />
  </main>
  <Footer />
</Layout> 
