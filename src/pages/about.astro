---
import Layout from '../layouts/Layout.astro';
import Header from '../components/common/Header.astro';
import Footer from '../components/common/Footer.astro';
import HeroSection from '../components/common/HeroSection.astro';
import Team from '../components/common/Team.astro';
import CallToAction from '../components/common/CallToAction.astro';
import MissionSection from '../components/about/MissionSection.astro';
import PipelineSection from '../components/about/PipelineSection.astro';
import MethodologySection from '../components/about/MethodologySection.astro';
import OpenSection from '../components/about/OpenSection.astro';
---

<Layout
  title="About | Wattnet"
  description="Who's behind Wattnet, how it measures the environmental footprint of European electricity, and the team building it."
>
  <Header />
  <main>
    <HeroSection
      title="About Wattnet"
      highlightText="About"
      description="Who's behind Wattnet, how it measures the environmental footprint of European electricity, and the team building it."
    />

    <!-- Mission -->
    <MissionSection />

    <PipelineSection />

    <MethodologySection />

    <!-- Team -->
    <Team
      badge="Who We Are"
      heading="The Team Behind Wattnet"
      intro="Wattnet is built and maintained by a small team at IFCA in Santander, spanning software engineering, environmental data modeling, and predictive analytics, all part of the Advanced Computing and e-Science Group."
      showCopyAll={false}
    />

    <!-- Open & reproducible -->
    <OpenSection />

    <CallToAction
      title="See Wattnet in action"
      description="Explore the live dashboard and start tracking the carbon and water footprint of electricity across Europe."
    />
  </main>
  <Footer />
</Layout>
