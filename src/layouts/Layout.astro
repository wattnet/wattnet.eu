---
import '../styles/global.css';
import '../styles/transitions.css';
import background from '../assets/wattnet-background.svg';
import { ClientRouter } from 'astro:transitions';
import { Image } from "astro:assets";

export interface Props {
  title: string;
  description?: string;
  ogImage?: string;
}

const { 
  title, 
  description = "An open-source service for tracking the environmental footprint of electricity across Europe.",
  ogImage
} = Astro.props;

const canonicalUrl = Astro.url.href;
const siteName = "wattnet.eu";
const defaultOgImage = new URL('/og/wattnet-og.png', Astro.url).href;
const resolvedOgImage = ogImage ?? defaultOgImage;
---

<!doctype html>
<html lang="en" x-data="{ darkMode: localStorage.getItem('darkMode') === 'true' }" x-init="$watch('darkMode', val => localStorage.setItem('darkMode', val))" :class="{ 'dark': darkMode }">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href="/favicon.ico" sizes="any">
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="canonical" href={canonicalUrl} />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#3a78e0" />
    <meta name="format-detection" content="telephone=no" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={resolvedOgImage} />
    <meta property="og:image:alt" content={title} />
    <meta property="og:image:type" content="image/svg+xml" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={resolvedOgImage} />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link 
      href="https://fonts.googleapis.com/css2?family=Red+Hat+Display:wght@500;800&family=Red+Hat+Text:wght@500;800&family=Red+Hat+Mono:wght@500;800&display=swap" 
      rel="stylesheet">
    <ClientRouter />
  </head>
  <body class="antialiased bg-white dark:bg-secondary-950 text-secondary-900 dark:text-secondary-100 transition-colors duration-300">
    <div id="page-loader" aria-hidden="true" transition:persist>
      <img src="/wattnet-loader.svg" alt="" width="120" height="120" />
    </div>
    <style>
      #page-loader {
        position: fixed;
        inset: 0;
        z-index: 9999;
        display: flex;
        align-items: center;
        justify-content: center;
        background: white;
        transition: opacity 0.4s ease, visibility 0.4s ease;
      }
      .dark #page-loader {
        background: #020617;
      }
      #page-loader.loaded {
        opacity: 0;
        visibility: hidden;
      }
    </style>
    <Image
      id="background"
      src={background}
      alt="Wattnet background pattern"
      style={{
        position: "fixed",
        top: "0",
        left: "0",
        width: "100%",
        height: "100%",
        zIndex: "-1",
        filter: "blur(100px)",
        opacity: "1",
      }}
    />
    <div id="page-wrapper" class="page-transition-wrapper">
    
    <!-- DEVELOPMENT BANNER --> 
   <style>
      .dev-banner {
        background: #94CE24;
        color: #1f2937;
        text-align: center;
        padding: 0.3rem 1rem;
        font-size: 0.85rem;
        font-weight: 500;
      }

      .dev-banner strong {
        font-weight: 800;
      }

      /* Texto alternativo en móvil */
      .dev-banner .mobile-text {
        display: none;
      }

      @media (max-width: 640px) {
        .dev-banner .desktop-text {
          display: none;
        }
        .dev-banner .mobile-text {
          display: inline;
          font-size: 0.75rem;
        }
      }
    </style>

    <div class="dev-banner" aria-hidden="true">
      <span class="desktop-text">
        <span>The dashboard is <strong>now live</strong>.</span>
        <span class="ml-4">This service is under <strong>active development</strong>.</span>
        <a target="_blank" rel="noopener noreferrer" href="https://dashboard.wattnet.eu" class="ml-4">Open dashboard → <strong>dashboard.wattnet.eu</strong></a>
      </span>
      <span class="mobile-text">
        Dashboard is <strong>live</strong>.
        <a target="_blank" rel="noopener noreferrer" href="https://dashboard.wattnet.eu">Open →</a>
      </span>
    </div>

      <slot />
    </div>
    <script>
      // Check for user preference
      if (localStorage.getItem('darkMode') === null) {
        // Check system preference
        if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
          localStorage.setItem('darkMode', 'true');
          document.documentElement.classList.add('dark');
        } else {
          localStorage.setItem('darkMode', 'false');
        }
      }

      // Handle page transitions
      const loaderStart = Date.now();
      const loaderMinMs = 1000;

      document.addEventListener('astro:page-load', () => {
        const pageWrapper = document.getElementById('page-wrapper');
        if (pageWrapper) {
          pageWrapper.classList.add('page-loaded');
        }

        const elapsed = Date.now() - loaderStart;
        const remaining = Math.max(0, loaderMinMs - elapsed);
        setTimeout(() => {
          const loader = document.getElementById('page-loader');
          if (loader) loader.classList.add('loaded');
        }, remaining);
      });

      document.addEventListener('astro:before-swap', () => {
        const pageWrapper = document.getElementById('page-wrapper');
        if (pageWrapper) {
          pageWrapper.classList.remove('page-loaded');
        }
      });
    </script>
    <script src="../scripts/transitions.js"></script>
  </body>
</html>
