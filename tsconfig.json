{
	"extends": "astro/tsconfigs/strict",
	"include": [".astro/types.d.ts", "**/*"],
	"exclude": ["dist"],
	"compilerOptions": {
		"jsx": "react-jsx", // O "react-jsx" si usas Preact X
		"jsxImportSource": "preact",
		"strict": true,
		"moduleResolution": "node",
		"target": "esnext",
		"module": "esnext",
		"esModuleInterop": true,
		"skipLibCheck": true
	}
}
